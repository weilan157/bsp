# 泰山派 SDK 可选厂商内核配置（叠加在官方 rockchip_linux_defconfig + rk3576.config 之上）
# 启用：config.env 中 TSPI_VENDOR_KERNEL_CONFIG=y

# 开源 GPU（SDK 桌面镜像常用 Panfrost + 保留 Mali Bifrost）
CONFIG_DRM_PANFROST=y
CONFIG_MALI_BIFROST=y
CONFIG_MALI_PLATFORM_NAME="rk"
CONFIG_MALI_BIFROST_EXPERT=y
CONFIG_MALI_BIFROST_DEBUG=y

# SDK rk3576.config
# CONFIG_MALI_CSF_SUPPORT is not set
CONFIG_TOUCHSCREEN_GT9XX=y
