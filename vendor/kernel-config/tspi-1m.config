# 泰山派 1M（RK3566）板级内核配置增量
# 参考 SDK：kernel-6.1 里 LCKFB 对 rockchip_linux_defconfig 的改动
# （提交 "适配泰山派1M" / "Buildroot system compatible with tspi-1m"）

# ---- 板载 AP6212A：走厂商 bcmdhd ----
# dts 用 wlan-platdata / bluetooth-platdata 节点，固件名由下面两项决定
CONFIG_WIFI_BUILD_MODULE=y
CONFIG_AP6XXX=m
CONFIG_BCMDHD_FW_PATH="/lib/firmware/fw_bcm43438a1.bin"
CONFIG_BCMDHD_NVRAM_PATH="/lib/firmware/nvram_ap6212a.txt"
CONFIG_RFKILL_RK=y

# ---- LED ----
# dts 里 RGB 灯用 linux,default-trigger = "timer"
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_BACKLIGHT=y
CONFIG_LEDS_TRIGGER_CPU=y
CONFIG_LEDS_TRIGGER_GPIO=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y

# ---- 扩展板 ----
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDC_MBIM=y
CONFIG_USB_NET_QMI_WWAN=y
CONFIG_DRM_PANEL_EDP=y

# 说明：SDK 还打开了 CONFIG_LTE / CONFIG_LTE_RM310（drivers/net/lte 的 4G 模组
# 驱动），那是 SDK 内核里额外加的源码，GitHub 官方内核没有该目录，
# 这里不打开，避免 kconfig 出现未知符号。
