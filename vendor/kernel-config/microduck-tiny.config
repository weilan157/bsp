# microduck：泰山派 1M（RK3566）极简内核增量
#
# 目标：只保留 板载 WiFi/BT(bcmdhd+AP6212A) + 音频(RK809/I2S) + MIPI 摄像头(ISP/CIF/OV5695)，
# 其余（显示/GPU/视频编解码/图像加速/USB/以太网/多余文件系统/调试设施）全部关掉，
# 兼顾 5s 内启动与 ZRAM。
#
# 用法（与 rk3566.config、bsp-boot.config、tspi-1m.config 叠加）：
#   KERNEL_DEFCONFIG_FRAGMENTS="rk3566.config bsp-boot.config tspi-1m.config microduck-tiny.config"

# ---- 体积与启动 ----
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_KALLSYMS is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_ROCKCHIP_RKNPU is not set
# CONFIG_HIBERNATION is not set

# ---- 显示 / GPU：全部不要 ----
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_LOGO is not set
# 启动速度：不要 VT 控制台（没有屏幕，串口 console 不需要它）
# CONFIG_VT is not set
# CONFIG_VT_CONSOLE is not set
CONFIG_PRINTK_TIME=y
# CONFIG_MALI_BIFROST is not set
# CONFIG_MALI400 is not set
# CONFIG_MALI_MIDGARD is not set
# CONFIG_DRM_PANFROST is not set

# ---- 视频编解码 / 图像加速（摄像头 ISP 除外）----
# CONFIG_ROCKCHIP_MPP_SERVICE is not set
# CONFIG_VIDEO_ROCKCHIP_RGA is not set
# CONFIG_VIDEO_ROCKCHIP_ISPP is not set
# CONFIG_VIDEO_ROCKCHIP_AIISP is not set
# CONFIG_VIDEO_ROCKCHIP_VPSS is not set
# CONFIG_VIDEO_ROCKCHIP_HDMIRX is not set
# CONFIG_VIDEO_ROCKCHIP_RKISP1 is not set
# CONFIG_VIDEO_ROCKCHIP_VPU is not set
# CONFIG_ROCKCHIP_MPP_RKVDEC is not set
# CONFIG_ROCKCHIP_MPP_RKVENC is not set

# ---- USB / PCIe / 以太网：不要 ----
# CONFIG_USB is not set
# CONFIG_PCI is not set
# CONFIG_STMMAC_ETH is not set
# CONFIG_GMAC_ROCKCHIP is not set

# ---- 网络协议栈裁剪（保留 IPv4 + WiFi/BT 所需）----
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_IPV6 is not set
# CONFIG_NET_SCHED is not set
# CONFIG_NET_CLS is not set
# CONFIG_NET_ACT is not set
# CONFIG_PACKET_DIAG is not set

# ---- 输入：不要触摸/键盘/鼠标（没有屏幕）----
# CONFIG_INPUT is not set
# CONFIG_INPUT_EVDEV is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_LEDS is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_INPUT_FF_MEMLESS is not set
# CONFIG_HID is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_TOUCHSCREEN_GT1X is not set
# CONFIG_TOUCHSCREEN_GT9XX is not set

# ---- 文件系统：只留 ext4/tmpfs/devtmpfs ----
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_9P_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_QUOTA is not set
# CONFIG_NFSD is not set
# CONFIG_CEPH_FS is not set
# CONFIG_AFS_FS is not set

# ---- 蓝牙：只要 HCI-UART(BCM) ----
# CONFIG_BT_HCIBTUSB is not set
# CONFIG_BT_HCIBTSDIO is not set
# CONFIG_BT_HCIUART_ATH3K is not set
# CONFIG_BT_HCIUART_3WIRE is not set
# CONFIG_BT_HCIUART_INTEL is not set
# CONFIG_BT_HCIUART_QCA is not set
# CONFIG_BT_HIDP is not set
# CONFIG_BT_RFCOMM is not set
# CONFIG_BT_BNEP is not set
# CONFIG_BT_6LOWPAN is not set
# CONFIG_BT_HCIVHCI is not set
# CONFIG_BT_MRVL is not set
# CONFIG_BT_MRVL_SDIO is not set

# ---- 音频：只要 RK809 + I2S + simple-card ----
# CONFIG_SND_SOC_ROCKCHIP_MULTICODECS is not set
# CONFIG_SND_SOC_ROCKCHIP_HDMI is not set
# CONFIG_SND_SOC_ROCKCHIP_SPDIF is not set
# CONFIG_SND_SOC_ROCKCHIP_SPDIFRX is not set
# CONFIG_SND_SOC_ROCKCHIP_PDM is not set
# CONFIG_SND_SOC_ROCKCHIP_PDM_V2 is not set
# CONFIG_SND_SOC_ROCKCHIP_SAI is not set
# CONFIG_SND_SOC_ROCKCHIP_ASRC is not set
# CONFIG_SND_SOC_ROCKCHIP_DLP is not set
# CONFIG_SND_SOC_ROCKCHIP_DLP_PCM is not set
# CONFIG_SND_SOC_ROCKCHIP_MAX98090 is not set
# CONFIG_SND_SOC_ROCKCHIP_RT5645 is not set
# CONFIG_SND_SOC_ROCKCHIP_VAD is not set
# CONFIG_SND_SOC_ROCKCHIP_I2S_TDM is not set
# CONFIG_SND_SOC_ROCKCHIP_DUMMY_DAI is not set
# CONFIG_SND_HDA is not set
# CONFIG_SND_USB is not set

# ---- 摄像头：ISP + CIF + CSI2 DPHY + OV5695 ----
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_V4L2_FWNODE=y
CONFIG_VIDEO_ROCKCHIP_ISP=y
CONFIG_VIDEO_ROCKCHIP_CIF=y
CONFIG_PHY_ROCKCHIP_CSI2_DPHY=y
CONFIG_VIDEO_OV5695=y
# CONFIG_MEDIA_USB_SUPPORT is not set
# CONFIG_MEDIA_PCI_SUPPORT is not set

# ---- WiFi / BT 驱动（板载 AP6212A）----
CONFIG_CFG80211=y
CONFIG_WIFI_BUILD_MODULE=y
CONFIG_AP6XXX=m
CONFIG_BT=y
CONFIG_BT_HCIUART=m
# BCM 协议由用户态 rk_hciattach/btattach 负责，内核只需要 H4
CONFIG_RFKILL_RK=y

# ---- 音频核心 ----
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_RK817=y
CONFIG_MFD_RK808=y
CONFIG_REGULATOR_RK808=y
# CONFIG_BATTERY_RK817 is not set
# CONFIG_CHARGER_RK817 is not set

# ---- ZRAM（开机由 init 配置成 swap）----
CONFIG_ZRAM=y
CONFIG_CRYPTO_LZ4=y
# 摄像头 ISP 需要 CMA，16MB 偏小
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZSMALLOC=y
# CONFIG_ZRAM_WRITEBACK is not set

# ---- 其它驱动/子系统裁剪 ----
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_NVME_CORE is not set
# CONFIG_MD is not set
# CONFIG_DM_CRYPT is not set
# CONFIG_WIRELESS is not set
# CONFIG_SSB is not set
# CONFIG_RFKILL_GPIO is not set
# CONFIG_IIO is not set
# CONFIG_HWMON is not set
# CONFIG_WATCHDOG is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_THERMAL_WRITABLE_TRIPS is not set
# CONFIG_CRYPTO_USER is not set
