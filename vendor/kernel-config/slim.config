# Orange Pi R2S 精简片段（叠在 linux-ky-current.config 上）
# 板卡：无 HDMI/摄像头/WiFi/BT/音频，仅串口 + 有线网 + USB + eMMC/SD
#
# 保留：NLS_ISO8859_1 / NLS_UTF8 / NLS_CODEPAGE_437（FAT /boot）
#       R8125 / MOTORCOMM_PHY（2.5G / 1G）
#       eth0/eth1=YT8531C 上网；PCIe RTL8125=EtherCAT（见 ethercat.config）

# ----- 显示 / GPU / 摄像头 -----
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_VGA_ARB is not set
# CONFIG_POWERVR_ROGUE is not set
# CONFIG_DRM_KY is not set
# CONFIG_KY_HDMI is not set
# CONFIG_KY_MIPI_PANEL is not set
# CONFIG_DRM_LT8911EXB is not set
# CONFIG_DRM_LT9711 is not set
# CONFIG_KY_HDMIAUDIO is not set
# CONFIG_KY_V2D is not set
# CONFIG_VIDEO_LINLON_X1 is not set
# CONFIG_KY_X1_CAMERA_V2 is not set
# CONFIG_KY_X1_CCIC_V2 is not set
# CONFIG_KY_X1_VI_V2 is not set
# CONFIG_KY_X1_VI_IOMMU is not set
# CONFIG_KY_X1_ISP_V2 is not set
# CONFIG_KY_X1_CPP_V2 is not set
# CONFIG_KY_X1_SENSOR_V2 is not set
# CONFIG_KY_X1_VIR_CAMERA is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_MEDIA_CAMERA_SUPPORT is not set

# ----- 音频 -----
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_KY_CARD is not set
# CONFIG_KY_PCM is not set
# CONFIG_KY_I2S is not set
# CONFIG_KY_DUMMYCODEC is not set

# ----- WiFi / BT（板载无无线） -----
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_BT is not set

# ----- 触控等无关输入 -----
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_TOUCHSCREEN_PROPERTIES is not set

# ----- 有线网关键驱动打进内核（少依赖 modules） -----
CONFIG_R8125=y
CONFIG_MOTORCOMM_PHY=y
# USB 网卡（可选；板载千兆已可上网）
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_ASIX=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_CDC_SUBSET=y

# ----- 减小体积 / 编译量 -----
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_GDB_SCRIPTS is not set
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_DYNAMIC_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_KGDB is not set
# CONFIG_PROFILING is not set
# CONFIG_DYNAMIC_DEBUG is not set

# ----- 裁掉无用 NLS 代码页模块（保留 iso8859-1/utf8/cp437） -----
# CONFIG_NLS_CODEPAGE_737 is not set
# CONFIG_NLS_CODEPAGE_775 is not set
# CONFIG_NLS_CODEPAGE_850 is not set
