#!/bin/sh
# microduck-bt —— 蓝牙常驻服务：自动配对手柄 + 定期重连
#
# 设计要点（都是踩过的坑）：
#   1) 不要用 btmgmt：aic8800 上 `btmgmt power on` 会挂住不返回，
#      整个服务卡死、后续扫描/配对全部不执行（表现为 Tasks 里挂着 btmgmt，
#      /run/bt.log 不存在）。统一改用 `timeout N bluetoothctl ...`。
#   2) Xbox 手柄配对成功后会长动断一次（reason 3），BlueZ 随即把它标成
#      Paired: no。所以重连逻辑不能要求 Paired: yes，只要名字像手柄且未连接
#      就每 10s trust+connect 一次。
#   3) input.conf 要 UserspaceHID=true、ClassicBondedOnly=false，
#      否则 HID 通道建不起来（没有 /dev/input/js*）。
set -u

RUN=/run/microduck
LOG="$RUN/bt.log"
FIFO="$RUN/bt.fifo"
SEEN="$RUN/bt.seen"
INPUT_CONF=/etc/bluetooth/input.conf
PAD_RE='[Xx][Bb][Oo][Xx]|[Gg]ame[Ss]ir|8[Bb]it[Dd]o|[Dd]ual[Ss]ense|[Dd]ual[Ss]hock|Pro Controller|[Gg]amepad|[Cc]ontroller'

mkdir -p "$RUN" /var/lib/bluetooth /run/bluetooth 2>/dev/null
kmsg() { printf 'microduck-bt: %s\n' "$*" > /dev/kmsg 2>/dev/null || true; }

kmsg "start"

# 1) input.conf：HID 走 userspace、允许未绑定的 classic HID
if [ -f "$INPUT_CONF" ]; then
	if grep -q '^UserspaceHID=' "$INPUT_CONF"; then
		sed -i 's/^UserspaceHID=.*/UserspaceHID=true/' "$INPUT_CONF"
	else
		echo 'UserspaceHID=true' >> "$INPUT_CONF"
	fi
	if grep -q '^ClassicBondedOnly=' "$INPUT_CONF"; then
		sed -i 's/^ClassicBondedOnly=.*/ClassicBondedOnly=false/' "$INPUT_CONF"
	else
		echo 'ClassicBondedOnly=false' >> "$INPUT_CONF"
	fi
fi

# 2) 等 hci0（AIC8800 的 btusb 是异步 probe）
i=0
while [ ! -d /sys/class/bluetooth/hci0 ] && [ "$i" -lt 150 ]; do
	sleep 0.1
	i=$((i + 1))
done
if [ ! -d /sys/class/bluetooth/hci0 ]; then
	kmsg "没有 hci0（btusb/hci_uart 没加载？）"
	exit 0
fi
kmsg "hci0 就绪"

# 3) bluetoothd（systemd 已拉起时跳过）
if ! pgrep -x bluetoothd >/dev/null 2>&1; then
	bluetoothd -n >/dev/null 2>&1 &
	sleep 1
	kmsg "bluetoothd 已启动"
fi

# 4) 上电/可配对（全部带 timeout，绝不允许挂住）
timeout 5 bluetoothctl power on    >/dev/null 2>&1 || true
timeout 5 bluetoothctl pairable on >/dev/null 2>&1 || true
timeout 5 hciconfig hci0 up        >/dev/null 2>&1 || true
kmsg "已上电/可配对"

# 5) 常驻 bluetoothctl 会话（agent + 扫描）
rm -f "$FIFO" "$SEEN"
mkfifo "$FIFO" 2>/dev/null || exit 0
: > "$SEEN"
: > "$LOG"
# shellcheck disable=SC2094
bluetoothctl < "$FIFO" > "$LOG" 2>&1 &
BT_PID=$!
exec 3> "$FIFO"
printf 'agent NoInputNoOutput\n' >&3
printf 'default-agent\n' >&3
printf 'power on\n' >&3
printf 'pairable on\n' >&3
printf 'scan le\n' >&3
kmsg "开始扫描（session pid=$BT_PID）"

pair_one() {
	mac=$1 name=$2
	grep -qx "$mac" "$SEEN" 2>/dev/null && return 0
	kmsg "尝试配对: $name ($mac)"
	printf 'pair %s\n' "$mac" >&3
	sleep 4
	printf 'trust %s\n' "$mac" >&3
	printf 'connect %s\n' "$mac" >&3
	echo "$mac" >> "$SEEN"
}

# 已配对/已信任的手柄重连：不要求 Paired=yes（Xbox 断开后 bond 会消失）
reconnect_pads() {
	timeout 5 bluetoothctl devices 2>/dev/null | while read -r _ mac name; do
		[ -n "${mac:-}" ] || continue
		printf '%s' "$name" | grep -qE "$PAD_RE" || continue
		info=$(timeout 5 bluetoothctl info "$mac" 2>/dev/null)
		printf '%s' "$info" | grep -q 'Connected: yes' && continue
		printf 'trust %s\n' "$mac" >&3
		printf 'connect %s\n' "$mac" >&3
	done
}

n=0
while [ -d /sys/class/bluetooth/hci0 ]; do
	# 记录扫描结果（microduck-diag 会带走）
	{
		printf -- '--- t=%ss devices ---\n' "$(cut -d' ' -f1 /proc/uptime)"
		timeout 5 bluetoothctl devices 2>/dev/null || true
	} >> "$LOG" 2>/dev/null || true

	# 新手柄（在配对模式里被发现）自动配对
	timeout 5 bluetoothctl devices 2>/dev/null | while read -r _ mac name; do
		[ -n "${mac:-}" ] || continue
		printf '%s' "$name" | grep -qE "$PAD_RE" || continue
		pair_one "$mac" "$name"
	done

	n=$((n + 1))
	[ $((n % 2)) -eq 0 ] && reconnect_pads
	sleep 5
done
kmsg "hci0 消失，退出"
