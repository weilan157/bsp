# microduck for Cubie A7Z（Allwinner A733 / sun60i）
#
# 叠在 Radxa 的 defconfig + radxa.config 之上：
#   make build KERNEL_DEFCONFIG="defconfig radxa.config microduck.config"
#
# 目标：与 RK3566 的 microduck 一致——无显示/GPU、无 USB/PCIe/以太网，
#       保留 WiFi/BT、音频、摄像头，另外**必须保留视频编解码**（A733 的 VE）。

# ---- BSP/SoC 选择（A733 = sun60iw2p1）----
# 缺了这些，bsp/drivers 会走 common 分支（比如 ve_plat_common 编不过）
CONFIG_AW_BSP=y
CONFIG_ARCH_SUNXI=y
CONFIG_ARCH_SUN60I=y
CONFIG_ARCH_SUN60IW2=y
CONFIG_ARCH_SUN60IW2P1=y

# bsp/drivers/input 的 init-input.ko 引用未导出的 irq_to_desc，
# modpost 会报 undefined!（6.6 内核里这个符号没有 EXPORT_SYMBOL）；
# microduck 本来也不要输入设备，直接关掉
# CONFIG_AW_INPUT_SENSORINIT is not set

# 主线的 sunxi-ng 时钟驱动和 BSP 的 bsp/drivers/clk/sunxi-ng 符号重名，
# 用 BSP 的（AW_CCU），关掉主线的 SUNXI_CCU，否则 vmlinux 链接报 multiple definition
# CONFIG_SUNXI_CCU is not set

# ---- 存储：BSP 的 MMC 驱动（root 分区在 SD 卡上，必须有）----
# 注意：bsp/drivers/mmc/Kconfig 里 AW_MMC 依赖 (MMC_HSQ || AW_MMC_HSQ)，
# 这两个都没开时 AW_MMC 根本不会出现在 .config 里 —— 表现就是内核根本没有
# mmcblk*，最后 panic 在 "VFS: Unable to mount root fs"。
# 主线的 MMC_SUNXI 依赖 SUNXI_CCU，被我们关掉了，所以只能用 BSP 的 AW_MMC。
CONFIG_AW_MMC_HSQ=y
CONFIG_AW_MMC=y
CONFIG_AW_MMC_V5P3X=y
# 探针日志（SM_INFO/SM_ERR 默认被 debuglevel 吞掉，出错时才看得出原因）
CONFIG_AW_MMC_DEBUG=y
CONFIG_AW_MMC_PRE_DBGLVL=5

# ---- 串口 console：BSP 的 UART 驱动注册的是 /dev/ttyAS* ----
# bootargs 里的 console= 要写 ttyAS0（写 ttyS0 会 "unable to open an initial console"）
# 注意：DT 里 uart 节点的 compatible 是 "allwinner,uart-v100"，只有
# sunxi-uart-ng 驱动认这个串，老的 AW_UART 匹配 "sun50i-uart" 绑不上
CONFIG_AW_UART=y
CONFIG_AW_UART_NG=y
CONFIG_AW_SERIAL_CONSOLE=y

# ---- 视频编解码（Allwinner BSP drivers/ve/cedar-ve + rt-media）----
# 这些符号来自 bsp/drivers/ve/cedar-ve/Kconfig 与 bsp/drivers/rt-media/Kconfig
CONFIG_AW_VIDEO_ENCODER_DECODER=y
CONFIG_AW_VIDEO_KERNEL_DEC=y
CONFIG_AW_VIDEO_KERNEL_ENC=y
# CONFIG_AW_VIDEO_DYNAMIC_DEBUG is not set
# rt-media 在 6.6 BSP 里引用旧版 vin 头（../vin/vin-video/vin_video.h），编不过；
# 视频编解码走 cedar-ve（AW_VIDEO_ENCODER_DECODER），不需要 rt-media
# CONFIG_VIDEO_RT_MEDIA is not set

# ---- 显示 / GPU：全部不要 ----
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_DRM_PANFROST is not set
# CONFIG_DRM_LIMA is not set
# CONFIG_DRM_PANTHOR is not set
# CONFIG_MALI400 is not set
# CONFIG_MALI450 is not set
# CONFIG_MALI470 is not set
# CONFIG_MALI_MIDGARD is not set
# CONFIG_MALI_BIFROST is not set
# 注意：A733 的 BSP 显示驱动在 allwinner-bsp 里，符号名以
# bsp/drivers/disp（或 bsp/drivers/video）下的 Kconfig 为准，接入后请核对

# ---- 视频采集（摄像头）保留 ----
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y
CONFIG_MEDIA_SUPPORT=y

# ---- USB / PCIe / 以太网：不要 ----
# CONFIG_USB is not set
# CONFIG_PCI is not set
# CONFIG_STMMAC_ETH is not set
# CONFIG_SUNXI_GMAC is not set

# ---- 网络裁剪 ----
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_IPV6 is not set

# ---- 文件系统：只留 ext4/tmpfs/devtmpfs ----
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_9P_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set

# ---- 调试设施 ----
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_FS is not set

# ---- 音频（BSP 的 sunxi sound）----
CONFIG_SND=y
CONFIG_SND_SOC=y
# 具体 codec 由 A7Z 的 dts 决定（es8316 / sunxi-codec），保留 BSP 默认即可

# ---- WiFi / BT ----
# Radxa 的 radxa.config 里已经打开 WLAN；A7Z 的板载芯片在
# allwinner-bsp/drivers/net/wireless 下（bcmdhd / aic8800 / rtl8xxx / xr829 之一）。
# 用板子实际的芯片打开对应项，例如：
#   CONFIG_AIC8800_WLAN=y
#   CONFIG_BCMDHD=y
CONFIG_WLAN=y
CONFIG_BT=y
CONFIG_BT_HCIUART=m

# ---- ZRAM（与 RK3566 分支一致，开机由 init 配置）----
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y

# ---- 启动裁剪：Tina《系统裁剪开发指南》2.3.1 的推荐项 ----
# 文档建议关掉"不使用的功能"来减小镜像、加快启动；这里只挑 6.6 里仍存在、
# 且对机器人业务无影响的选项（SYSV/POSIX mqueue 用不到，core dump 不要）。
# CONFIG_KALLSYMS is not set
# CONFIG_ELF_CORE is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_AIO is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_SYSV_IPC is not set
# 注意：SWAP 必须保留（ZRAM 要用），SHMEM 也要保留（很多程序依赖）