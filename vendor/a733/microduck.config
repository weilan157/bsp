# microduck for Cubie A7Z（Allwinner A733 / sun60i，sun60iw2p1）
#
# 叠在 Radxa 的 defconfig 之上（./bsp kernel = defconfig + merge_config + olddefconfig）
#
# 这份文件是"上板实测能启动"的配置，每条都对应一个曾经踩过的坑，
# 修改前请先读注释。原则：与 RK3566 的 microduck 一致——无显示/GPU、
# 无 USB/PCIe/以太网，保留 WiFi/BT、音频、视频编解码（A733 的 VE）。

# =====================================================================
# BSP / SoC 选择
# 缺了这些，bsp/drivers 会走 common 分支（ve_plat_common.c 编不过）
# =====================================================================
CONFIG_AW_BSP=y
CONFIG_ARCH_SUNXI=y
CONFIG_ARCH_SUN60I=y
CONFIG_ARCH_SUN60IW2=y
CONFIG_ARCH_SUN60IW2P1=y

# 板级（IC）模式：pinctrl-sun60iw2.c 用 AW_IC_BOARD 分支才是完整的
# 181 pin / 10 bank 表。开 FPGA（S4 或 V7）会走精简的 104-pin 表，
# 表现为 "unknown pin PG*/PC*/PF*"、pinctrl 永远 -517。
CONFIG_AW_IC_BOARD=y
# CONFIG_AW_FPGA_S4 is not set
# CONFIG_AW_FPGA_V7 is not set

# =====================================================================
# 基础外设（缺一个就起不来）
# =====================================================================
# DMA：uart-ng 要 TX/RX DMA 通道，没有就 "cannot get the TX DMA channel"
CONFIG_AW_DMA=y
# SID：sunxi_get_soc_ver() 由它提供，否则走 weak 桩返回 0
CONFIG_AW_SID=y
# wakeupgen：DT 根节点的 interrupt-parent 是 sunxi-wakeupgen，
# 不编它所有 SPI 中断都拿不到（pinctrl/uart/mmc 全是 -517）
CONFIG_AW_WAKEUPGEN=y

# =====================================================================
# I2C（TWI）+ AXP2101/AXP8191 PMIC
# HAT 上的 TLV320AIC3104 / VL53L5CX / BMI088 走 TWI7；
# CPU 调压、卡槽/USB 的稳压器都来自 AXP8191（u-boot 也打印 PMU: AXP8191）
# =====================================================================
CONFIG_AW_TWI=y
CONFIG_AW_MFD_AXP2101=y
CONFIG_AW_MFD_AXP2101_I2C=y
CONFIG_AW_REGULATOR_AXP2101=y
CONFIG_AW_INPUT_AXP2101_PEK=y
# 主线的 AXP20x MFD/regulator（drivers/mfd/axp20x.c）与 BSP 的
# bsp/drivers/power/mfd/axp2101.c 导出同名符号（axp20x_match_device /
# axp20x_device_probe / axp20x_device_remove），同时编会 multiple definition。
# A733 用 BSP 那一套，主线的必须关掉。
# CONFIG_MFD_AXP20X_I2C is not set
# CONFIG_MFD_AXP20X is not set
# CONFIG_MFD_AXP20X_RSB is not set
# CONFIG_REGULATOR_AXP20X is not set

# bsp/drivers/input 的 init-input.ko 引用未导出的 irq_to_desc（6.6 没 EXPORT_SYMBOL），
# modpost 会报 undefined；microduck 不需要它
# CONFIG_AW_INPUT_SENSORINIT is not set

# 主线的 sunxi-ng 时钟驱动与 BSP 的 bsp/drivers/clk/sunxi-ng 符号重名，
# 只保留 BSP 的 AW_CCU，关掉主线的 SUNXI_CCU，否则 vmlinux multiple definition
# CONFIG_SUNXI_CCU is not set

# =====================================================================
# 存储：BSP 的 MMC 驱动（rootfs 在 SD 卡上，必须有）
# AW_MMC 在 Kconfig 里依赖 (MMC_HSQ || AW_MMC_HSQ)：两个都没开时
# AW_MMC 不会出现在 .config 里 —— 内核没有 mmcblk*，最后 panic 在
# "VFS: Unable to mount root fs"。主线的 MMC_SUNXI 依赖 SUNXI_CCU，
# 被我们关掉了，所以只能用 BSP 的 AW_MMC。
# =====================================================================
CONFIG_AW_MMC_HSQ=y
CONFIG_AW_MMC=y
CONFIG_AW_MMC_V5P3X=y
# 调试等级：debug 会把每个命令都打出来（115200 下非常慢），平时关掉
# CONFIG_AW_MMC_DEBUG is not set
CONFIG_AW_MMC_PRE_DBGLVL=0

# =====================================================================
# 串口 console：BSP 的 uart-ng 注册的是 /dev/ttyAS*
# bootargs 必须写 console=ttyAS0（写 ttyS0 会 "unable to open an initial console"）
# DT 里 uart 的 compatible 是 "allwinner,uart-v100"，只有 uart-ng 认它
# =====================================================================
# CONFIG_AW_UART is not set
CONFIG_AW_UART_NG=y
CONFIG_AW_SERIAL_CONSOLE=y

# =====================================================================
# 视频编解码（BSP 的 drivers/ve/cedar-ve）
# rt-media 在 6.6 BSP 里还引用旧版 vin 头（../vin/vin-video/vin_video.h），
# 编不过；编解码只用 cedar-ve
# =====================================================================
CONFIG_AW_VIDEO_ENCODER_DECODER=y
CONFIG_AW_VIDEO_KERNEL_DEC=y
CONFIG_AW_VIDEO_KERNEL_ENC=y
# CONFIG_AW_VIDEO_DYNAMIC_DEBUG is not set
# CONFIG_VIDEO_RT_MEDIA is not set

# =====================================================================
# 显示 / GPU：全部不要（micro 镜像没有本地显示）
# =====================================================================
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# =====================================================================
# 视频采集（摄像头）保留
# =====================================================================
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y

# =====================================================================
# USB / PCIe / 以太网：不要（A7Z 的 micro 镜像用 SD 启动）
# =====================================================================
# CONFIG_USB is not set
# CONFIG_PCI is not set
# CONFIG_STMMAC_ETH is not set
# CONFIG_SUNXI_GMAC is not set

# =====================================================================
# 网络裁剪
# =====================================================================
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_IPV6 is not set

# =====================================================================
# 文件系统：只留 ext4/tmpfs/devtmpfs/vfat
# =====================================================================
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_9P_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set

# =====================================================================
# 调试设施：保留 KALLSYMS（panic 时要看调用栈符号）
# =====================================================================
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_ELF_CORE is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_AIO is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_SYSV_IPC is not set
# 注意：SWAP 必须保留（ZRAM 要用），SHMEM 也要保留（很多程序依赖）

# =====================================================================
# 音频（BSP 的 sunxi sound；具体 codec 由 DT 决定）
# =====================================================================
CONFIG_SND=y
CONFIG_SND_SOC=y

# =====================================================================
# WiFi / BT
# =====================================================================
CONFIG_WLAN=y
CONFIG_BT=y
CONFIG_BT_HCIUART=m

# =====================================================================
# ZRAM（与 RK3566 分支一致，开机由 rcS 配置）
# =====================================================================
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
