# microduck for Cubie A7Z（Allwinner A733 / sun60i）
#
# 叠在 Radxa 的 defconfig + radxa.config 之上：
#   make build KERNEL_DEFCONFIG="defconfig radxa.config microduck.config"
#
# 目标：与 RK3566 的 microduck 一致——无显示/GPU、无 USB/PCIe/以太网，
#       保留 WiFi/BT、音频、摄像头，另外**必须保留视频编解码**（A733 的 VE）。

# ---- 视频编解码（Allwinner BSP drivers/ve/cedar-ve + rt-media）----
# 这些符号来自 bsp/drivers/ve/cedar-ve/Kconfig 与 bsp/drivers/rt-media/Kconfig
CONFIG_AW_VIDEO_ENCODER_DECODER=y
CONFIG_AW_VIDEO_KERNEL_DEC=y
CONFIG_AW_VIDEO_KERNEL_ENC=y
# CONFIG_AW_VIDEO_DYNAMIC_DEBUG is not set
CONFIG_VIDEO_RT_MEDIA=y
# CONFIG_RT_MEDIA_DUAL_SENSOR is not set
# CONFIG_RT_MEDIA_SETUP_RECORDER_IN_KERNEL is not set

# ---- 显示 / GPU：全部不要 ----
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_DRM_PANFROST is not set
# CONFIG_DRM_LIMA is not set
# CONFIG_DRM_PANTHOR is not set
# CONFIG_MALI400 is not set
# CONFIG_MALI450 is not set
# CONFIG_MALI470 is not set
# CONFIG_MALI_MIDGARD is not set
# CONFIG_MALI_BIFROST is not set
# 注意：A733 的 BSP 显示驱动在 allwinner-bsp 里，符号名以
# bsp/drivers/disp（或 bsp/drivers/video）下的 Kconfig 为准，接入后请核对

# ---- 视频采集（摄像头）保留 ----
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y
CONFIG_MEDIA_SUPPORT=y

# ---- USB / PCIe / 以太网：不要 ----
# CONFIG_USB is not set
# CONFIG_PCI is not set
# CONFIG_STMMAC_ETH is not set
# CONFIG_SUNXI_GMAC is not set

# ---- 网络裁剪 ----
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_IPV6 is not set

# ---- 文件系统：只留 ext4/tmpfs/devtmpfs ----
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_9P_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set

# ---- 调试设施 ----
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_FS is not set

# ---- 音频（BSP 的 sunxi sound）----
CONFIG_SND=y
CONFIG_SND_SOC=y
# 具体 codec 由 A7Z 的 dts 决定（es8316 / sunxi-codec），保留 BSP 默认即可

# ---- WiFi / BT ----
# Radxa 的 radxa.config 里已经打开 WLAN；A7Z 的板载芯片在
# allwinner-bsp/drivers/net/wireless 下（bcmdhd / aic8800 / rtl8xxx / xr829 之一）。
# 用板子实际的芯片打开对应项，例如：
#   CONFIG_AIC8800_WLAN=y
#   CONFIG_BCMDHD=y
CONFIG_WLAN=y
CONFIG_BT=y
CONFIG_BT_HCIUART=m

# ---- ZRAM（与 RK3566 分支一致，开机由 init 配置）----
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
