# microduck for Cubie A7Z（Allwinner A733 / sun60i，sun60iw2p1）
#
# 叠在 Radxa 的 defconfig 之上（./bsp kernel = defconfig + merge_config + olddefconfig）
#
# 这份文件是"上板实测能启动"的配置，每条都对应一个曾经踩过的坑，
# 修改前请先读注释。原则：与 RK3566 的 microduck 一致——无显示/GPU、
# 无 USB/PCIe/以太网，保留 WiFi/BT、音频、视频编解码（A733 的 VE）。

# =====================================================================
# BSP / SoC 选择
# 缺了这些，bsp/drivers 会走 common 分支（ve_plat_common.c 编不过）
# =====================================================================
CONFIG_AW_BSP=y
CONFIG_ARCH_SUNXI=y
CONFIG_ARCH_SUN60I=y
CONFIG_ARCH_SUN60IW2=y
CONFIG_ARCH_SUN60IW2P1=y

# 板级（IC）模式：pinctrl-sun60iw2.c 用 AW_IC_BOARD 分支才是完整的
# 181 pin / 10 bank 表。开 FPGA（S4 或 V7）会走精简的 104-pin 表，
# 表现为 "unknown pin PG*/PC*/PF*"、pinctrl 永远 -517。
CONFIG_AW_IC_BOARD=y
# CONFIG_AW_FPGA_S4 is not set
# CONFIG_AW_FPGA_V7 is not set

# =====================================================================
# 基础外设（缺一个就起不来）
# =====================================================================
# DMA：uart-ng 要 TX/RX DMA 通道，没有就 "cannot get the TX DMA channel"
CONFIG_AW_DMA=y
# SID：sunxi_get_soc_ver() 由它提供，否则走 weak 桩返回 0
CONFIG_AW_SID=y
# wakeupgen：DT 根节点的 interrupt-parent 是 sunxi-wakeupgen，
# 不编它所有 SPI 中断都拿不到（pinctrl/uart/mmc 全是 -517）
CONFIG_AW_WAKEUPGEN=y

# =====================================================================
# I2C（TWI）+ AXP2101/AXP8191 PMIC
# HAT 上的 TLV320AIC3104 / VL53L5CX / BMI088 走 TWI7；
# CPU 调压、卡槽/USB 的稳压器都来自 AXP8191（u-boot 也打印 PMU: AXP8191）
# =====================================================================
CONFIG_AW_TWI=y
CONFIG_AW_MFD_AXP2101=y
CONFIG_AW_MFD_AXP2101_I2C=y
CONFIG_AW_REGULATOR_AXP2101=y
CONFIG_AW_INPUT_AXP2101_PEK=y
# 主线的 AXP20x MFD/regulator（drivers/mfd/axp20x.c）与 BSP 的
# bsp/drivers/power/mfd/axp2101.c 导出同名符号（axp20x_match_device /
# axp20x_device_probe / axp20x_device_remove），同时编会 multiple definition。
# A733 用 BSP 那一套，主线的必须关掉。
# CONFIG_MFD_AXP20X_I2C is not set
# CONFIG_MFD_AXP20X is not set
# CONFIG_MFD_AXP20X_RSB is not set
# CONFIG_REGULATOR_AXP20X is not set

# bsp/drivers/input 的 init-input.ko 引用未导出的 irq_to_desc（6.6 没 EXPORT_SYMBOL），
# modpost 会报 undefined；microduck 不需要它
# CONFIG_AW_INPUT_SENSORINIT is not set

# 主线的 sunxi-ng 时钟驱动与 BSP 的 bsp/drivers/clk/sunxi-ng 符号重名，
# 只保留 BSP 的 AW_CCU，关掉主线的 SUNXI_CCU，否则 vmlinux multiple definition
# CONFIG_SUNXI_CCU is not set

# =====================================================================
# 存储：BSP 的 MMC 驱动（rootfs 在 SD 卡上，必须有）
# AW_MMC 在 Kconfig 里依赖 (MMC_HSQ || AW_MMC_HSQ)：两个都没开时
# AW_MMC 不会出现在 .config 里 —— 内核没有 mmcblk*，最后 panic 在
# "VFS: Unable to mount root fs"。主线的 MMC_SUNXI 依赖 SUNXI_CCU，
# 被我们关掉了，所以只能用 BSP 的 AW_MMC。
# =====================================================================
CONFIG_AW_MMC_HSQ=y
CONFIG_AW_MMC=y
CONFIG_AW_MMC_V5P3X=y
# 调试等级：debug 会把每个命令都打出来（115200 下非常慢），平时关掉
# CONFIG_AW_MMC_DEBUG is not set
CONFIG_AW_MMC_PRE_DBGLVL=0

# =====================================================================
# 串口 console：BSP 的 uart-ng 注册的是 /dev/ttyAS*
# bootargs 必须写 console=ttyAS0（写 ttyS0 会 "unable to open an initial console"）
# DT 里 uart 的 compatible 是 "allwinner,uart-v100"，只有 uart-ng 认它
# =====================================================================
# CONFIG_AW_UART is not set
CONFIG_AW_UART_NG=y
CONFIG_AW_SERIAL_CONSOLE=y

# =====================================================================
# 视频编解码（BSP 的 drivers/ve/cedar-ve）
# rt-media 在 6.6 BSP 里还引用旧版 vin 头（../vin/vin-video/vin_video.h），
# 编不过；编解码只用 cedar-ve
# =====================================================================
CONFIG_AW_VIDEO_ENCODER_DECODER=y
CONFIG_AW_VIDEO_KERNEL_DEC=y
CONFIG_AW_VIDEO_KERNEL_ENC=y
# CONFIG_AW_VIDEO_DYNAMIC_DEBUG is not set
# CONFIG_VIDEO_RT_MEDIA is not set

# =====================================================================
# 显示 / GPU：全部不要（micro 镜像没有本地显示）
# =====================================================================
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# =====================================================================
# 视频采集（摄像头）保留
# =====================================================================
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y

# =====================================================================
# USB / PCIe / 以太网：不要（A7Z 的 micro 镜像用 SD 启动）
# =====================================================================
# CONFIG_USB is not set
# CONFIG_PCI is not set
# CONFIG_STMMAC_ETH is not set
# CONFIG_SUNXI_GMAC is not set

# =====================================================================
# 网络裁剪
# =====================================================================
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_IPV6 is not set

# =====================================================================
# 文件系统：只留 ext4/tmpfs/devtmpfs/vfat
# =====================================================================
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_9P_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set

# =====================================================================
# 调试设施：保留 KALLSYMS（panic 时要看调用栈符号）
# =====================================================================
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_ELF_CORE is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_AIO is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_SYSV_IPC is not set
# 注意：SWAP 必须保留（ZRAM 要用），SHMEM 也要保留（很多程序依赖）

# =====================================================================
# 音频（BSP 的 sunxi sound；具体 codec 由 DT 决定）
# =====================================================================
CONFIG_SND=y
CONFIG_SND_SOC=y

# =====================================================================
# WiFi / BT
#
# 原理图（radxa_Cubie_A7Z_v1100）：WiFi/BT 是 **FCU760K 模块**，
#   - 数据口是 **USB1（USB2.0，USB1-DP/DM）**，不是 SDIO；
#   - 电源/使能：WL-REG-EN（PM0 → USB_WIFI_PWR）、CHIP_EN（PM1）；
#   - 所以必须打开 USB 主机，否则 WiFi/BT 完全没有总线。
# 驱动用 BSP 自带的 aic8800（源码里带 FCU760 标识）：
#   AIC_WLAN_SUPPORT + AIC_INTF_USB  -> aic8800_fdrv（WiFi）
#   AIC_INTF_USB + AIC8800_BTUSB_SUPPORT -> aic8800_btusb（蓝牙 USB）
# =====================================================================
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
# CONFIG_AIC_WLAN_SUPPORT is not set
CONFIG_AIC_INTF_USB=y
# aic8800_bsp 的 Makefile 是 obj-m（只能编成模块），所以 fdrv 也必须是模块，
# 否则内建进 vmlinux 时链接不到 aicbsp_get_feature 等符号。
# CONFIG_AIC8800_WLAN_SUPPORT is not set
# 蓝牙（aic8800_btusb）在 6.6 上暂时编不过，是厂商代码用的旧 API 已移除：
#   aic_btusb.h: mm_segment_t / get_fs / set_fs / KERNEL_DS 全部不存在了，
#   还有 class_create() 的签名变化。
# 要恢复必须改这些调用（不是加宏能解决的），留作待办；WiFi 不受影响。
# CONFIG_AIC8800_BTUSB_SUPPORT is not set
CONFIG_BT=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_WLAN=y

# =====================================================================
# 摄像头（原理图 J5：31-pin CAM 连接器）
#
# 硬件这边是清楚的：MIPI CSI **2 lane**（MCSIB D0/D1 + CLKA/CLKB），
# 控制走 **TWI3（PE3/PE4）**，另有 MCSI-RST-R / MCSI-STBY-R / MCSI-MCLK(PE5)。
#
# 但**当前 6.6 树上 BSP 的 VIN 栈编不过**（实测两处 API 不兼容）：
#   bsp/drivers/vin/vin-cci/cci_helper.c: sensor_driver->probe 参数个数不匹配
#   bsp/drivers/vin/utility/vin_os.c  : dma_heap_find/buffer_alloc/free 未声明
# 这两处要按 6.6 的 API 做移植（v4l2_subdev 的 probe 签名 + dma-heap 头文件），
# 移植完成前不能开 AW_VIDEO_SUNXI_VIN，否则 vmlinux 直接编译失败。
# 因此这里只保留主线的 V4L2/IMX219（=m），等 VIN 移植好再打开。
CONFIG_AW_VIDEO_SUNXI_VIN=y
CONFIG_CSI_VIN=y
# CONFIG_CSI_CCI is not set
CONFIG_VIDEO_IMX219=m

# =====================================================================
# ZRAM（与 RK3566 分支一致，开机由 rcS 配置）
# =====================================================================
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y

# 主线 V4L2 的 CCI（drivers/media/v4l2-core/v4l2-cci.c）与 BSP VIN 的
# bsp/drivers/vin/vin-cci/bsp_cci.c 都导出 cci_read/cci_write，
# 同时编进 vmlinux 会 "exported twice"。A7Z 用 BSP 的 VIN 栈，
# 所以主线的 V4L2_CCI（连同依赖它的主线 sensor 驱动）必须关掉，
# sensor 走 BSP 自己的 drivers/vin/modules/sensor。
# CONFIG_V4L2_CCI is not set
# CONFIG_VIDEO_IMX219 is not set

# BSP VIN 的 IMX219 传感器驱动（bsp/drivers/vin/modules/sensor/imx219.c），
# 由 DT 的 sensor_list0/sensor0 通过 mname="imx219" 匹配。
CONFIG_SENSOR_IMX219=y

# USB1（WiFi/BT 所在的那条 USB2.0）在 DT 里的 compatible 是
#   allwinner,sunxi-ehci0 / allwinner,sunxi-ohci0
# 只有 BSP 自带的 host 驱动认这两个字符串；主线的 USB_EHCI_HCD_PLATFORM /
# USB_OHCI_HCD_PLATFORM 只匹配 generic-ehci/generic-ohci，绑不上。
# 缺了这两个，/sys/bus/usb/devices/ 会是空的（实测就是如此）。
CONFIG_USB_EHCI_HCD_SUNXI=y
CONFIG_USB_OHCI_HCD_SUNXI=y

# BSP USB host 的目录门禁：bsp/drivers/usb/Makefile 只有 CONFIG_USB_SUNXI_HCI
# 才会进入 host/ 子目录（ehci-sunxi.o / ohci-sunxi.o 都在里面）。
# 而 USB_SUNXI_HCI 又依赖 USB_SUNXI_HCD。只设 USB_EHCI_HCD_SUNXI 是不够的
# （它只在 host/ 内部生效），实测 USB 总线会完全为空。
CONFIG_USB_SUNXI_HCD=y
CONFIG_USB_SUNXI_HCI=y

# VIN 的 DT 节点带 iommus = <&mmu_aw ...>（compatible = "allwinner,iommu-v20"）。
# 不开 IOMMU 的话 provider 不存在，vind0/isp/vinc 会永远 -EPROBE_DEFER，
# 最终 "deferred probe timeout ... failed with error -110"。
# CONFIG_AW_IOMMU is not set
# CONFIG_AW_IOMMU_V2 is not set
# VIN 不用 IOMMU（避免 iommu_master attach -517 时 vin_iommu_en 空指针）
# CONFIG_VIN_IOMMU is not set
CONFIG_USB_SUNXI_PHY=y
CONFIG_USB_SUNXI_AWPHY=y

# BSP ehci/ohci-sunxi 的 OF_MATCH 是按 CONFIG_USB_SUNXI_EHCI0/1/2/3 条件编译的：
# 不开对应开关时宏会变成 "null"，DT 节点永远匹配不上，probe 不触发，
# /sys/bus/usb/devices 就是空的（实测踩到）。
# A7Z 的 DT 里有 ehci0/ohci0（4101000/4101400）和 ehci1/ohci1（4200000/4200400），
# 两个都打开。
CONFIG_USB_SUNXI_EHCI0=y
CONFIG_USB_SUNXI_OHCI0=y
CONFIG_USB_SUNXI_EHCI1=y
CONFIG_USB_SUNXI_OHCI1=y
# CONFIG_USB_MSG_EP is not set

# VIN 的 debug 注册（sunxi_vin_debug_register_driver）和 devices_deferred /
# clk_summary 等排查手段都依赖 debugfs；之前是关的，导致 VIN 一开机就报
# "sunxi_vin_debug_register_driver failed"。
CONFIG_DEBUG_FS=y

# VIN 顶层的 DT 里有 power-domains = <&power-controller>，而 power-controller
# 的 compatible 是 "allwinner,sun60iw2-pck-600"，驱动在
# bsp/drivers/pm_domain/pck600_domains.c（Kconfig: AW_PCK600_DOMAINS）。
#
# 不开这个，devlink 会认为 vind0 的 supplier 永远不存在，**vin_probe 根本不会
# 被调用**（实测 dmesg 里一条 VINPROBE 都没有，vmlinux 里却有 7 处），
# 最后只看到 "deferred probe timeout, ignoring dependency ... error -110"。
CONFIG_AW_PCK600_DOMAINS=y

# A733 的 BSP configs 里没有 CCI 节点（只有 sun50iw9/sun8iw11 那种老 SoC 才有
# csi_cci0/1），而 bsp/drivers/vin/vin-cci/sunxi_cci.c 的 probe 需要 DT 节点提供
# device_id / irq / reg。没有节点就没有 cci_dev，运行时报 "cci is NULL!"，
# 于是 IMX219 读 ID 得到 0x0，报 "chip found is not an target chip"。
#
# vin.c 里：如果 CONFIG_CCI_MODULE || CONFIG_CCI 打开，就会强制
#   sensor_type = VIN_MODULE_TYPE_CCI
# 关掉 CSI_CCI（连带 CCI 那个 choice）后，VIN 改用 DT 的 sensor_bus_type，
# 也就是真正的 TWI（sensor0_twi_cci_id = <3> → TWI3，PE3/PE4 已经启用）。

# WiFi 改用 Radxa 官方 USB 驱动包（vendor/a733/aic8800-usb）：
#   aic_load_fw   —— 只管 Boot ROM(0x8d80) 阶段的固件下载与启动
#   aic8800_fdrv  —— 对 8d81 运行态设备建 wlan0
# BSP 自带的 aic8800_bsp/aic8800_fdrv 与我们手改的补丁路径已证明跑不通
# （固件启动后 ~2.5s 抛异常），且模块名与 Radxa 的 aic8800_fdrv 冲突，
# 所以整体关掉，由脚本单独编译安装 Radxa 那两个模块。

# 蓝牙 HID host（用 Xbox / PS 等蓝牙手柄控制本板）
#   UHID        —— BlueZ 的 HID-over-GATT(hog) 靠它在内核创建输入设备，
#                  没有它手柄能配对成功但不会出现 /dev/input/eventX
#   INPUT_UINPUT/INPUT_JOYDEV —— 用户态注入 + 老式 /dev/input/jsN 接口
#   BT_LE       —— 低功耗蓝牙：Xbox One S / Series X|S 手柄走 BLE HID，
#                  Classic 手柄(BR/EDR) 不受影响
CONFIG_UHID=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_JOYDEV=y
CONFIG_BT_LE=y
