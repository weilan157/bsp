/* 40-pin 排针（J11）映射——按原理图 40PIN Connector 页核对：
 *   3/5    TWI7_SDA/TWI7_SCK        → &twi7（HAT I2C@400k）
 *   7/11   PB0/PB1                   → 未用
 *   13/15  PL6_3V3/PL7_3V3           → 未用（PL7 = BMI088 INT）
 *   19/21/23/24 SPI1_MOSI/MISO/CLK/CS0 → 未用
 *   27/28  TWI2-SDA/TWI2-SCK         → 未用（HAT ID EEPROM DNP）
 *   31/33  PB2/PB3                   → PB2 = 关机检测；PB3 未用
 *   8/10   CPUX-TX/RX（UART0）       → 舵机总线
 *   12/35/36/38/40 I2S0 BCLK/LRCK/MCLK/DIN0/DOUT0 → 音频
 *   16/18 PJ24/PJ25_3V3, 22 PL5_3V3, 32 PM5_3V3, 37 PM4_3V3 → 电源
 */
// microduck HAT 适配（Cubie A7Z / Allwinner A733）
//
// ./bsp kernel 会把官方 board.dts 存成 board-a7z.dts，生成：
//   #include "board-a7z.dts"
//   #include "microduck-a7z.dtsi"
// 所以这里可以安全地覆盖/追加节点，不改官方文件。

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>

/* =====================================================================
 * 1. 舵机串口：UART0 = PB9/PB10（排针 pin 8/10）
 *    波特率 1 Mbps、半双工由 HAT 硬件处理，DT 只负责把引脚给 UART0。
 *    官方 board.dts 里 uart0_pins_active 是空的（pins = "", ""），这里换成
 *    真实引脚；node 名不同，避免和官方节点重名。
 * ===================================================================== */
&pio {
	uart0_servo_pins: uart0-servo-pins {
		pins = "PB9", "PB10";
		function = "uart0";
		drive-strength = <10>;
	};

	uart0_servo_sleep: uart0-servo-sleep {
		pins = "PB9", "PB10";
		function = "gpio_in";
		drive-strength = <10>;
	};
};

&uart0 {
	status = "okay";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&uart0_servo_pins>;
	pinctrl-1 = <&uart0_servo_sleep>;
};

/* 注意：console 不能再用 uart0，见 vendor/a733/boot.cmd（console=tty1）。
 * 用户态的 /dev/ttyAS0（部分 BSP 是 /dev/ttyS0）由 8250 驱动生成，
 * 具体名字上板后 ls /dev/tty* 确认。 */

/* =====================================================================
 * 2. I2C：TWI7 = PJ22/PJ23（排针 pin 3/5）→ /dev/i2c-7
 *    HAT 上的设备（RPI Robot HAT，400 kHz）：
 *      0x18 TLV320AIC3104  音频 codec（I2S 数据 + I2C 控制）
 *      0x29 VL53L5CX       ToF（Stemma 座）
 *      0x19 BMI088 加速度计 / 0x68 陀螺（焊了但官方软件不用，声明出来给 HAL）
 *      0x6A LSM6DSV16X     D1 版 HAT 用它替代 BMI088（默认不打开）
 * ===================================================================== */
&twi7 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&twi7_pins_default>;
	pinctrl-1 = <&twi7_pins_sleep>;

	audio_codec: tlv320aic3104@18 {
		compatible = "ti,tlv320aic3104";
		reg = <0x18>;
		#sound-dai-cells = <0>;
		status = "okay";
	};

	tof: vl53l5cx@29 {
		compatible = "st,vl53l5cx";
		reg = <0x29>;
		status = "okay";
	};

	bmi088_accel: bmi088-accel@19 {
		compatible = "bosch,bmi088-accel";
		reg = <0x19>;
		status = "okay";
	};

	bmi088_gyro: bmi088-gyro@68 {
		compatible = "bosch,bmi088-gyro";
		reg = <0x68>;
		status = "okay";
	};

	/* D1 版 HAT：BMI088 换成 LSM6DSV16X（0x6A），需要时取消注释
	lsm6dsv16x@6a {
		compatible = "st,lsm6dsv16x";
		reg = <0x6a>;
		status = "okay";
	};
	*/
};

/* =====================================================================
 * 3. 音频 I2S0：PB5/PB6/PB7/PB8 = 排针 pin 12/35/40/38（BCLK/LRCK/DOUT/DIN），
 *    MCLK 在 PB4（pin 36）。用 Allwinner 的 soundcard-mach 把 codec 挂上。
 * ===================================================================== */
&i2s0_plat {
	status = "okay";
	tdm-num = <0>;
	tx-pin = <0 1 2 3>;
	tx-pin0-map0 = <0x76543210>;
	tx-pin0-map1 = <0xFEDCBA98>;
	rx-pin = <0>;
	dai-type = "i2s";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2s0_pins_a>, <&i2s0_pins_b>, <&i2s0_pins_c>,
		    <&i2s0_pins_e>, <&i2s0_pins_d>;
	pinctrl-1 = <&i2s0_pins_f>;
};

&i2s0_mach {
	status = "okay";
	soundcard-mach,codec {
		sound-dai = <&audio_codec>;
	};
};

/* HDMI 音频不再使用（micro 镜像无显示） */
&i2s3_plat {
	status = "disabled";
};
&i2s3_mach {
	status = "disabled";
};

/* =====================================================================
 * 4. 离散 GPIO
 *    pin 31 = PB2：HAT 关机检测 → gpio-keys（KEY_POWER）
 *    pin 33 = PB3：本设计未用
 *    pin 15 = PL7：BMI088 中断，软件不用，留空
 *    pin 27/28 = TWI2-SDA/SCK：HAT ID I2C（EEPROM DNP），留空
 * ===================================================================== */
/ {
	gpio-keys {
		compatible = "gpio-keys";
		status = "okay";

		hat_power_detect: hat-power-detect {
			label = "hat-power-detect";
			gpios = <&pio PB 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};
	};
};

/* =====================================================================
 * 5. 显示：micro 镜像不需要，关掉 DE/HDMI，省启动时间
 * ===================================================================== */
&de {
	status = "disabled";
};
&hdmi0 {
	status = "disabled";
};
&hdmi_codec {
	status = "disabled";
};

/* 摄像头（IMX219）单独放在 microduck-a7z-camera.dtsi，默认不启用：
 * A7Z 的 MIPI CSI 连接器用哪路 TWI/CSI，需要按板子原理图确认。 */

/* =====================================================================
 * R-PIO（PL/PM 区）先关掉
 * 这颗 BSP pinctrl 驱动在 r_pinctrl probe 时会 Oops：
 *   sunxi_bsp_pinctrl_init_with_variant+0x47c
 *   sun60iw2_r_pinctrl_probe
 * 直接把系统打死（kworker 里 deferred probe 时崩溃），连 ttyAS0/SD 都起不来。
 * microduck 用不到 PL/PM 引脚（HAT 全在 PB/PJ/PI 上），先 disabled。
 * ===================================================================== */
&r_pio {
	/* R 侧引脚（PL/PM）必须可用，否则整条 R 域全瘫：
	 *   - s_twi0/s_twi1 的引脚在 PL0/PL1（PMIC AXP8191 挂在 s_twi0 上），
	 *     关掉 r_pio 会让两条 TWI 一直 -EPROBE_DEFER，PMIC 永远不 probe；
	 *   - usb2-vbus / wifi_power_en / wifi_chip_en / leds 都用 PL2/PM0/PM1/PM2；
	 *   - HAT 的 TWI7（codec/IMU/ToF）也在 R 侧。
	 * 早期关掉它是因为 r_pinctrl probe 会 Oops，那是 TWI/AXP 驱动缺失时的
	 * deferred probe 时序问题；这些驱动补齐后实测稳定，故恢复 okay。
	 */
	status = "okay";
};

/* =====================================================================
 * 6. 上板实测必需的 SD / 中断覆盖（2026-10-24，从跑通的 dtb 反推回来）
 *
 * - 本板只有 SD 槽、没有 eMMC：sdc1/sdc2 关掉，否则 CQHCI 会一直刷 RTO。
 * - sdc0：
 *     * 无卡检测 GPIO（卡槽常闭）→ non-removable，并删掉 cd-* 属性；
 *     * 删掉 vmmc 以及 vqmmc/vdmmc 的 33sw/18sw 稳压器引用：这几路电压由 AXP8191
 *       提供，但内核侧 PMIC/TWI 驱动还没接入，留着会让 sdc0 probe 一直 -517；
 *     * 限 25MHz 并去掉 UHS 三种模式（UHS 需要 1.8V 切换，同样等 PMIC 接好）；
 *     * 中断直连 GIC（interrupt-parent = <&gic>）：sdc0 的命令完成中断经
 *       sunxi-wakeupgen 域时收不到（命令发出去后永远等不到 irq），直连后一次就通。
 * ===================================================================== */
&sdc1 {
	status = "disabled";
};

&sdc2 {
	status = "disabled";
};

&sdc0 {
	/delete-property/ vmmc-supply;
	/delete-property/ vqmmc33sw-supply;
	/delete-property/ vdmmc33sw-supply;
	/delete-property/ vqmmc18sw-supply;
	/delete-property/ vdmmc18sw-supply;
	/delete-property/ cd-gpios;
	/delete-property/ cd-used-24M;
	/delete-property/ cd-set-debounce;
	/delete-property/ sd-uhs-sdr50;
	/delete-property/ sd-uhs-ddr50;
	/delete-property/ sd-uhs-sdr104;
	non-removable;
	max-frequency = <25000000>;
	interrupt-parent = <&gic>;
};

/* =====================================================================
 * 7. 摄像头 VIN（原理图 J5：31-pin CAM，MIPI CSI 2-lane）
 *
 * board.dts 默认把整个 VIN 树关掉（vind0、csiN、mipiN、ispN、vincN）。
 * 这里按 MCSIB（D0/D1 + CLKA/CLKB）那组打开最小集合：
 *   vind0 = VIN 顶层（时钟/中断/寄存器）
 *   csi1  = MCSIB 通道；mipi1 = 对应 MIPI 接收
 *   isp00 = ISP；vinc00 = 视频输入捕获口（/dev/video* 从这里出）
 * 传感器驱动还需要按实际模组在 bsp/drivers/vin/modules/sensor 里选型，
 * 并把 sensor_list 配置补上，否则只有 VIN 设备、没有可用 video 节点。
 * ===================================================================== */
&vind0 {
	status = "okay";
};

&csi1 {
	status = "okay";
};

&mipi1 {
	status = "okay";
};

&isp00 {
	status = "okay";
};

&vinc00 {
	status = "okay";
	/* MCSIB（MIPI CSI B）→ csi1 + mipi1；isp0；sensor_list0 */
	vinc0_csi_sel = <1>;
	vinc0_mipi_sel = <1>;
	vinc0_isp_sel = <0>;
	vinc0_isp_tx_ch = <0>;
	vinc0_rear_sensor_sel = <0>;
	vinc0_front_sensor_sel = <0>;
	vinc0_sensor_list = <0>;
};

/* ---------------------------------------------------------------------
 * IMX219（31-pin CAM，MIPI 2-lane，I2C = TWI3/PE3+PE4，地址 0x10）
 *
 * BSP VIN 的传感器不是在 i2c 节点下声明，而是：
 *   sensor_list0  —— 候选传感器列表（VIN 按顺序探测，能读 ID 的那个胜出）
 *   sensor0       —— 探测成功后使用的详细配置（mname/twi/时钟/GPIO/电源）
 * mname 必须等于驱动里的 SENSOR_NAME（imx219.c 里是 "imx219"）。
 * twi_addr 是 8 位地址：IMX219 7 位 0x10 → 0x20。
 * twi_cci_id 与 TWI 序号一致（3 = TWI3）。
 * ------------------------------------------------------------------- */

&pio {
	twi3_pins_default: twi3@0 {
		pins = "PE3", "PE4";
		function = "twi3";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi3_pins_sleep: twi3@1 {
		pins = "PE3", "PE4";
		function = "gpio_in";
		bias-pull-up;
	};
};

&twi3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&twi3_pins_default>;
	pinctrl-1 = <&twi3_pins_sleep>;
	status = "okay";
};

&sensor_list0 {
	status = "okay";
	csi_sel = <0>;
	sensor00_mname = "imx219";
	sensor00_twi_addr = <0x20>;
	sensor00_type = <1>;
	sensor00_hflip = <0>;
	sensor00_vflip = <0>;
	sensor00_act_used = <0>;
	sensor00_act_name = "";
	sensor00_act_twi_addr = <>;
};

&sensor0 {
	status = "okay";
	sensor0_mname = "imx219";
	sensor0_twi_cci_id = <3>;
	sensor0_twi_addr = <0x20>;
	sensor0_mclk_id = <0>;
	sensor0_pos = "rear";
	sensor0_isp_used = <0>;
	sensor0_fmt = <0>;
	sensor0_stby_mode = <0>;
	sensor0_vflip = <0>;
	sensor0_hflip = <0>;
	sensor0_iovdd-supply = <>;
	sensor0_iovdd_vol = <>;
	sensor0_avdd-supply = <>;
	sensor0_avdd_vol = <>;
	sensor0_dvdd-supply = <>;
	sensor0_dvdd_vol = <>;
	/* 3V3/5V 由板上 DCDC1 → FB1 常供，没有独立控制脚；
	 * MCSI-RST-R / MCSI-STBY-R 走 PE/PK 的 GPIO，等确认引脚号后补
	 * sensor0_reset / sensor0_pwdn（先让传感器能被 I2C 探测到）。 */
	sensor0_power_en = <>;
	sensor0_reset = <>;
	sensor0_pwdn = <>;
	sensor0_sm_vs = <>;
	flash_handle = <>;
	act_handle = <>;
};

/* =====================================================================
 * 8. 关掉 board.dts 漏掉的 scaler 节点
 *
 * board.dts 只 disable 了 scaler00-03/10/20/30/40/50，漏了
 * scaler11/12/13/21/22/23/31/32/33。这些节点默认 okay 会去 probe，
 * 其中 scaler11(59103fc) 在 deferred probe 里空指针崩溃（scaler_probe+0x2b8），
 * 把 deferred-probe 的 kworker 打死，导致后面 VIN/sensor 探测全部中断。
 * microduck 不用 VIN 的硬件缩放，直接全部关掉。
 * ===================================================================== */
&scaler11 { status = "disabled"; };
&scaler12 { status = "disabled"; };
&scaler13 { status = "disabled"; };
&scaler21 { status = "disabled"; };
&scaler22 { status = "disabled"; };
&scaler23 { status = "disabled"; };
&scaler31 { status = "disabled"; };
&scaler32 { status = "disabled"; };
&scaler33 { status = "disabled"; };

/* =====================================================================
 * 9. VIN 不用 IOMMU（去掉 iommus 引用）
 *
 * DT 里 vind0/csi/isp/vinc 都带 iommus = <&mmu_aw ...>。开了 AW_IOMMU 之后
 * iommu_master attach 一直 -517，导致 vin_core_probe 里 vin_iommu_en()
 * 拿到 NULL 直接 Oops（sunxi_iommu_distribute_mater_get+0x3c）。
 * microduck 用 CMA（dma_alloc_coherent）就够，直接把 iommus 删掉，
 * 同时配置里关掉 AW_IOMMU / VIN_IOMMU。
 * ===================================================================== */
&vind0 { /delete-property/ iommus; };
&csi1  { /delete-property/ iommus; };
&mipi1 { /delete-property/ iommus; };
&isp00 { /delete-property/ iommus; };
&vinc00 { /delete-property/ iommus; };
