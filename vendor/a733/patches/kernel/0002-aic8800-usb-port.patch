+	/* AIC8800 USB FIX (power): sunxi_wlan_set_power() 在本 BSP 快照里只有
+	 * extern 声明、没有实现（原实现属于板级支持包）。USB 路径不需要它：
+	 * board.dts 里 wifi_power_en/wifi_chip_en 都是 regulator-always-on +
+	 * regulator-boot-on，上电即常开。SDIO 路径保持原样。 */
+#ifdef AICWF_SDIO_SUPPORT
 	sunxi_wlan_set_power(1);
+#endif
 	mdelay(50);
 #endif
 	return 0;
@@ -78,7 +96,9 @@ static int aicbsp_platform_power_on(void)
 static void aicbsp_platform_power_off(void)
 {
 #ifdef CONFIG_PLATFORM_ALLWINNER
+#ifdef AICWF_SDIO_SUPPORT
 	sunxi_wlan_set_power(0);
+#endif
 	mdelay(100);
 #endif
 	bsp_dbg("%s\n", __func__);
