diff --git a/drivers/net/wireless/aic8800/aic8800_bsp/aicusb.c b/drivers/net/wireless/aic8800/aic8800_bsp/aicusb.c
index 71998d8..1075260 100644
--- a/drivers/net/wireless/aic8800/aic8800_bsp/aicusb.c
+++ b/drivers/net/wireless/aic8800/aic8800_bsp/aicusb.c
@@ -50,6 +50,18 @@ void aicbsp_device_exit(void)
 
 static struct device_match_entry aicdev_match_table[] = {
 	{0xa69c, 0x8800, PRODUCT_ID_AIC8800D,   "aic8800d",   0, 0}, // 8800d in bootloader mode
+	/* AIC8800 USB FIX (bsp not own 8d80): 这颗 FCU760K 的 USB PID 一直是
+	 * 0x8d80（单接口 ff/ff/ff，2 个 bulk 端点），固件下载前后都不重新枚举。
+	 *
+	 * 实测：aic8800_fdrv 依赖 aic8800_bsp 的符号，modprobe fdrv 会自动把 bsp
+	 * 拉起来；bsp 先在 match 表里命中 8d80 并绑定设备，然后因为芯片已在
+	 * 运行态，下载命令直接超时：
+	 *     cmd timed-out / tkn[0] flags:0012 result: -4 cmd:1024
+	 *     aicwf_usb_probe: failed with errno 0
+	 * 此后 fdrv 再注册 USB 驱动也抢不到设备，wlan0 永远不出现（实测）。
+	 *
+	 * 所以 bsp 只保留它真正该负责的 bootloader PID 0x8800，
+	 * 8d80/8d81 交给 aic8800_fdrv 自己去探测和下载固件。 */
 };
 
 static struct device_match_entry *aic_matched_ic;
