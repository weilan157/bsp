diff --git a/drivers/net/wireless/aic8800/aic8800_bsp/aic_bsp_8800d80.c b/drivers/net/wireless/aic8800/aic8800_bsp/aic_bsp_8800d80.c
index d3a3371..9332ec6 100644
--- a/drivers/net/wireless/aic8800/aic8800_bsp/aic_bsp_8800d80.c
+++ b/drivers/net/wireless/aic8800/aic8800_bsp/aic_bsp_8800d80.c
@@ -399,7 +399,11 @@ static int aicwifi_patch_config(struct priv_dev *aicdev)
 	}
 	rd_version_val = rd_patch_addr_cfm.memdata;
 	printk("rd_version_val=%08X\n", rd_version_val);
+	/* AIC8800 USB FIX (d80): fw_version_uint 只定义在 SDIO 的 struct priv_dev
+	 * (aicsdio.h)，USB 版 (aicusb.h) 没有该成员，无条件赋值会让 USB 构建失败。*/
+#ifdef AICWF_SDIO_SUPPORT
 	aicdev->fw_version_uint = rd_version_val;
+#endif
 	if (rd_version_val > 0x06090100) {
 		patch_buff_addr = rd_patch_addr + 12;
 		ret = rwnx_send_dbg_mem_read_req(aicdev, patch_buff_addr, &rd_patch_addr_cfm);
@@ -602,8 +606,15 @@ int aicbsp_8800d80_fw_init(struct priv_dev *aicdev)
 #elif defined(AICWF_USB_SUPPORT)
 	if (aicbsp_info.chipinfo->rev == CHIP_REV_ID_U02)
 		 aicbsp_firmware_list = fw_u02;
-	else if (aicbsp_info.chipinfo->rev == CHIP_REV_ID_U03)
-		aicbsp_firmware_list = fw_u03;
+	/* AIC8800 USB FIX (fw table): 这根 FCU760K（aic8800d80，rev 0x7）会落到
+	 * fw_u01[]，而 u01 表没有 .bt_ext_patch 字段，aicbt_ext_patch_data_load()
+	 * 拼出 "(null)0.bin" 直接失败；fw_u03 的固件又不随 BSP 发布。
+	 * 手上只有 u02 那套（aic8800d80/*_u02.bin，含 _ext0），且同一份代码的
+	 * SDIO 分支本来就把 U03 当 U02，这里统一用 fw_u02。
+	 */
+	else if (aicbsp_info.chipinfo->rev == CHIP_REV_ID_U03 ||
+		 aicbsp_info.chipinfo->rev == CHIP_REV_ID_U01)
+		aicbsp_firmware_list = fw_u02;
 #endif
 
 	if (aicbsp_system_config(aicdev))
diff --git a/drivers/net/wireless/aic8800/aic8800_bsp/aicusb.c b/drivers/net/wireless/aic8800/aic8800_bsp/aicusb.c
index 71998d8..bd12256 100644
--- a/drivers/net/wireless/aic8800/aic8800_bsp/aicusb.c
+++ b/drivers/net/wireless/aic8800/aic8800_bsp/aicusb.c
@@ -50,6 +50,11 @@ void aicbsp_device_exit(void)
 
 static struct device_match_entry aicdev_match_table[] = {
 	{0xa69c, 0x8800, PRODUCT_ID_AIC8800D,   "aic8800d",   0, 0}, // 8800d in bootloader mode
+	/* AIC8800 USB D80 FIX: FCU760K 模块的 USB PID 是 0x8d80（bootloader 模式）。
+	 * 这颗芯片在 SDIO 表里是 0x0182 -> PRODUCT_ID_AIC8800D80，但 USB 表原本没这一项，
+	 * 导致设备枚举成功却没有任何驱动绑定（实测 a69c:8d80）。 */
+	{0xa69c, 0x8d80, PRODUCT_ID_AIC8800D80, "aic8800d80", 0, 0},
+	{0xa69c, 0x8d81, PRODUCT_ID_AIC8800D80, "aic8800d80", 0, 0},
 };
 
 static struct device_match_entry *aic_matched_ic;
@@ -69,7 +74,13 @@ void *aicbsp_get_drvdata(void *args)
 static int aicbsp_platform_power_on(void)
 {
 #ifdef CONFIG_PLATFORM_ALLWINNER
+	/* AIC8800 USB FIX (power): sunxi_wlan_set_power() 在本 BSP 快照里只有
+	 * extern 声明、没有实现（原实现属于板级支持包）。USB 路径不需要它：
+	 * board.dts 里 wifi_power_en/wifi_chip_en 都是 regulator-always-on +
+	 * regulator-boot-on，上电即常开。SDIO 路径保持原样。 */
+#ifdef AICWF_SDIO_SUPPORT
 	sunxi_wlan_set_power(1);
+#endif
 	mdelay(50);
 #endif
 	return 0;
@@ -78,7 +89,9 @@ static int aicbsp_platform_power_on(void)
 static void aicbsp_platform_power_off(void)
 {
 #ifdef CONFIG_PLATFORM_ALLWINNER
+#ifdef AICWF_SDIO_SUPPORT
 	sunxi_wlan_set_power(0);
+#endif
 	mdelay(100);
 #endif
 	bsp_dbg("%s\n", __func__);
@@ -1012,6 +1025,8 @@ static int aicwf_usb_reset_resume(struct usb_interface *intf)
 static struct usb_device_id aicwf_usb_id_table[] = {
 	{USB_DEVICE(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC)},
 	{USB_DEVICE(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC_8801)},
+	{USB_DEVICE(USB_VENDOR_ID_AIC, 0x8d80)},
+	{USB_DEVICE(USB_VENDOR_ID_AIC, 0x8d81)},
 	{}
 };
 
