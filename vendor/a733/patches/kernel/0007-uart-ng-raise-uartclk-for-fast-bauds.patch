diff --git a/drivers/uart/sunxi-uart-ng-core.c b/drivers/uart/sunxi-uart-ng-core.c
index 58b5214..17f0e27 100644
--- a/drivers/uart/sunxi-uart-ng-core.c
+++ b/drivers/uart/sunxi-uart-ng-core.c
@@ -564,6 +564,33 @@ static int sunxi_uart_check_baudset(struct uart_port *port, unsigned int baud)
 		}
 
 		setsel = &baud_set[i];
+		if (port->uartclk < setsel->uartclk_min) {
+			/* microduck: raise uartclk for fast bauds.
+			 * apb-uart 默认来自 sys24M（24MHz），而 1Mbps 的波特率分频
+			 * 表要求 uartclk >= 31MHz，否则下面直接 return -1，端口停在
+			 * 旧速率上（用户态 stty 却"成功"）。apb-uart 的父时钟可选
+			 * pll-peri0-600m/480m，抬高到 100MHz 后 1Mbps 才真正可设。
+			 */
+			if (uart_port->mclk && !IS_ERR(uart_port->mclk)) {
+				/* microduck: switch parent first.
+				 * apb-uart 是 M_WITH_MUX，clk_set_rate 不会自己换父时钟，
+				 * 单独 clk_set_rate(100MHz) 会返回 0 但 rate 仍是 24MHz。
+				 */
+				struct clk *p = clk_get(NULL, "pll-peri0-600m");
+				if (!p || IS_ERR(p))
+					p = clk_get(NULL, "pll-peri0-480m");
+				if (p && !IS_ERR(p)) {
+					clk_set_parent(uart_port->mclk, p);
+					clk_put(p);
+				}
+				if (!clk_set_rate(uart_port->mclk, 100000000)) {
+					port->uartclk = clk_get_rate(uart_port->mclk);
+					sunxi_info(port->dev,
+						"uart%d raised uartclk to %d for baud %d\n",
+						uart_port->id, port->uartclk, baud);
+				}
+			}
+		}
 		if (port->uartclk < setsel->uartclk_min
 			|| port->uartclk > setsel->uartclk_max) {
 			sunxi_info(port->dev, "uart%d, select set %d, baud %d, uartclk %d beyond rance[%d, %d]\n",
