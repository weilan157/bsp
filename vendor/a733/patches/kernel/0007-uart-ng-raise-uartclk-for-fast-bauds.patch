diff --git a/drivers/uart/sunxi-uart-ng-core.c b/drivers/uart/sunxi-uart-ng-core.c
index 58b5214..f66ceba 100644
--- a/drivers/uart/sunxi-uart-ng-core.c
+++ b/drivers/uart/sunxi-uart-ng-core.c
@@ -524,6 +524,46 @@ struct baudset {
 	u32 uartclk_max;
 };
 
+/*
+ * microduck: 1 Mbps 要求 uartclk >= 31 MHz，而 apb-uart 默认来自 sys24M(24MHz)。
+ * CCF 里 clk_set_rate 只在当前父时钟下分频、clk_get(NULL, name) 又找不到 CCF 时钟，
+ * 所以直接写 CCU 寄存器：ccu@2002000 + 0x0538
+ *   bit0..4   = M（6）
+ *   bit24..26 = 父时钟（3 = pll-peri0-600m）
+ *   600 MHz / 6 = 100 MHz
+ * 注意 apb-uart 是所有 UART 共用，console 的分频要等 getty 重新打开端口时才按新时钟重算。
+ */
+static bool sunxi_apb_uart_raised;
+
+static int sunxi_uart_raise_apb_uart_clk(void)
+{
+	struct device_node *np;
+	void __iomem *base;
+	u32 v;
+
+	if (sunxi_apb_uart_raised)
+		return 0;
+
+	np = of_find_compatible_node(NULL, NULL, "allwinner,sun60iw2-ccu");
+	if (!np)
+		return -ENODEV;
+	base = of_iomap(np, 0);
+	of_node_put(np);
+	if (!base)
+		return -ENOMEM;
+
+	v = readl(base + 0x0538);
+	v &= ~((0x1f << 0) | (0x7 << 24));
+	v |= (6 << 0) | (3 << 24);
+	writel(v, base + 0x0538);
+	v = readl(base + 0x0538);
+	iounmap(base);
+
+	sunxi_apb_uart_raised = true;
+	pr_info("microduck: apb-uart -> pll-peri0-600m/6, reg538=0x%08x (expect 100MHz)\n", v);
+	return 0;
+}
+
 static int sunxi_uart_check_baudset(struct uart_port *port, unsigned int baud)
 {
 	struct sunxi_uart_port *uart_port = UART_TO_SPORT(port);
@@ -564,6 +604,17 @@ static int sunxi_uart_check_baudset(struct uart_port *port, unsigned int baud)
 		}
 
 		setsel = &baud_set[i];
+		if (port->uartclk < setsel->uartclk_min) {
