#!/bin/sh
### BEGIN INIT INFO
# Provides:          rockchip-partnames
# Required-Start:    $local_fs
# Default-Start:     2 3 4 5
# Short-Description: GPT partition symlinks (/dev/block/by-name)
### END INIT INFO

case "$1" in
start)
	mkdir -p /dev/block/by-name
	for part in /sys/class/block/mmcblk*p[0-9]*; do
		[ -d "$part" ] || continue
		name=$(grep -m1 PARTNAME "$part/uevent" 2>/dev/null | cut -d= -f2)
		[ -n "$name" ] || continue
		ln -sf "/dev/$(basename "$part")" "/dev/block/by-name/$name"
	done
	;;
stop) ;;
*) echo "Usage: $0 {start|stop}" >&2; exit 1 ;;
esac
exit 0
