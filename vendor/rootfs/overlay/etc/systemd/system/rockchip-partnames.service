[Unit]
Description=Rockchip GPT partition symlinks (/dev/block/by-name)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target
ConditionPathExists=/sys/class/block

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/rockchip-partnames

[Install]
WantedBy=sysinit.target
