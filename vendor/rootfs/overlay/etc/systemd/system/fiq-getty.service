[Unit]
Description=Getty on Rockchip FIQ debugger (ttyFIQ0)
Documentation=man:agetty(8)
After=systemd-user-sessions.service plymouth-quit-wait.service
# 不依赖 udev 的 dev-ttyFIQ0.device（FIQ 调试口通常不生成该 unit）
ConditionPathExists=/dev/ttyFIQ0

[Service]
# RK 调试串口默认 1500000；若终端乱码可改为 115200
ExecStart=-/sbin/agetty -8 -L -f /etc/issue ttyFIQ0 1500000 linux
Type=idle
Restart=always
RestartSec=0
UtmpIdentifier=ttyFIQ0
TTYPath=/dev/ttyFIQ0
TTYReset=yes
TTYVHangup=yes
IgnoreSIGPIPE=no
SendSIGHUP=yes
StandardInput=tty
StandardOutput=tty
StandardError=journal

[Install]
WantedBy=getty.target
