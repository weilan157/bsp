#!/bin/sh
# 解析板载双 RTL8125（PCI 10ec:8125），生成 /run/ethercat.conf 供 ethercatctl 使用
set -eu
PATH="/usr/sbin:/sbin:/usr/bin:/bin:${PATH:-}"

OUT="${1:-/run/ethercat.conf}"
TMP="${OUT}.tmp.$$"

ifaces=""
macs=""
n=0

# 优先按 PCI vendor:device 匹配 net 接口
for d in /sys/bus/pci/devices/*; do
	[ -d "$d" ] || continue
	ven=$(cat "$d/vendor" 2>/dev/null || true)
	dev=$(cat "$d/device" 2>/dev/null || true)
	[ "$ven" = "0x10ec" ] && [ "$dev" = "0x8125" ] || continue
	netdir=""
	for nd in "$d"/net/*; do
		[ -d "$nd" ] || continue
		netdir="$nd"
		break
	done
	[ -n "$netdir" ] || continue
	iface=$(basename "$netdir")
	mac=$(cat "$netdir/address" 2>/dev/null || true)
	ifaces="${ifaces} ${iface}"
	macs="${macs} ${mac}"
	n=$((n + 1))
done

# 回退：按 r8125 驱动 / enp* 名
if [ "$n" -eq 0 ]; then
	for d in /sys/class/net/*; do
		[ -d "$d" ] || continue
		iface=$(basename "$d")
		[ "$iface" = "lo" ] && continue
		drv=""
		if [ -L "$d/device/driver" ]; then
			drv=$(basename "$(readlink -f "$d/device/driver")")
		fi
		case "$drv" in
			r8125) ;;
			*)
				case "$iface" in
					enp*) ;;
					*) continue ;;
				esac
				;;
		esac
		mac=$(cat "$d/address" 2>/dev/null || true)
		ifaces="${ifaces} ${iface}"
		macs="${macs} ${mac}"
		n=$((n + 1))
	done
fi

ifaces=$(echo "$ifaces" | sed 's/^ *//')
macs=$(echo "$macs" | sed 's/^ *//')

main_dev="ff:ff:ff:ff:ff:ff"
backup_line="#MASTER0_BACKUP=\"\""
updown=""

if [ "$n" -ge 1 ]; then
	set -- $ifaces
	main_dev="$1"
	updown="$ifaces"
	if [ "$n" -ge 2 ]; then
		backup_line="MASTER0_BACKUP=\"$2\""
	fi
fi

cat > "${TMP}" <<EOF
# Generated by ethercat-board-conf — do not edit; regenerate on start
MASTER0_DEVICE="${main_dev}"
${backup_line}
DEVICE_MODULES="generic"
UPDOWN_INTERFACES="${updown}"
EOF

mv -f "${TMP}" "${OUT}"
echo "ethercat-board-conf: wrote ${OUT} (ifaces=${updown:-none} n=${n})"

# 拉起接口，供 generic 使用
for iface in $updown; do
	ip link set "$iface" up 2>/dev/null || true
done

if [ "$n" -eq 0 ]; then
	echo "ethercat-board-conf: 未发现 RTL8125/enp*，仍写入广播 MAC 占位" >&2
	exit 0
fi
exit 0
