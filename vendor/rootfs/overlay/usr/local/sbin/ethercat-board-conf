#!/bin/sh
# Orange Pi R2S：为 ec_r8169 准备 RTL8125（从内置 r8125 手中接管）
# 1) 记录 PCI BDF + MAC
# 2) r8125 remove_id + unbind
# 3) 写 /run/ethercat.conf（DEVICE_MODULES=r8169）
set -eu
PATH="/usr/sbin:/sbin:/usr/bin:/bin:${PATH:-}"

OUT="${1:-/run/ethercat.conf}"
MODE="${ETHERCAT_DEVICE_MODULE:-r8169}"
TMP="${OUT}.tmp.$$"
STATE_DIR="/run/ethercat-r2s"
mkdir -p "${STATE_DIR}"

bdfs=""
macs=""
n=0

for d in /sys/bus/pci/devices/*; do
	[ -d "$d" ] || continue
	ven=$(cat "$d/vendor" 2>/dev/null || true)
	dev=$(cat "$d/device" 2>/dev/null || true)
	[ "$ven" = "0x10ec" ] && [ "$dev" = "0x8125" ] || continue
	bdf=$(basename "$d")
	mac=""
	for nd in "$d"/net/*; do
		[ -d "$nd" ] || continue
		mac=$(cat "$nd/address" 2>/dev/null || true)
		break
	done
	# 无 net 节点时仍记录 BDF（可能已被 unbind）
	bdfs="${bdfs} ${bdf}"
	macs="${macs} ${mac:-}"
	n=$((n + 1))
done

bdfs=$(echo "$bdfs" | sed 's/^ *//')
macs=$(echo "$macs" | sed 's/^ *//')

# 持久化 BDF 列表，供 stop 时归还 r8125
printf '%s\n' ${bdfs} > "${STATE_DIR}/pci-bdfs"
printf '%s\n' ${macs} > "${STATE_DIR}/macs"

handoff_from_r8125() {
	local bdf drv
	# 防止 r8125 再次自动认领 10ec:8125
	if [ -w /sys/bus/pci/drivers/r8125/remove_id ]; then
		echo "10ec 8125" > /sys/bus/pci/drivers/r8125/remove_id 2>/dev/null || true
	fi
	for bdf in $bdfs; do
		[ -d "/sys/bus/pci/devices/${bdf}" ] || continue
		drv=""
		if [ -L "/sys/bus/pci/devices/${bdf}/driver" ]; then
			drv=$(basename "$(readlink -f "/sys/bus/pci/devices/${bdf}/driver")")
		fi
		case "$drv" in
			r8125)
				echo "${bdf}" > /sys/bus/pci/drivers/r8125/unbind 2>/dev/null || true
				echo "ethercat-board-conf: unbound ${bdf} from r8125"
				;;
			ec_r8169)
				echo "ethercat-board-conf: ${bdf} already on ec_r8169"
				;;
			"")
				echo "ethercat-board-conf: ${bdf} unbound"
				;;
			*)
				echo "ethercat-board-conf: ${bdf} driver=${drv}（跳过 unbind）" >&2
				;;
		esac
		# 优先让后续 modprobe ec_r8169 绑上
		if [ -w "/sys/bus/pci/devices/${bdf}/driver_override" ]; then
			echo "ec_r8169" > "/sys/bus/pci/devices/${bdf}/driver_override" 2>/dev/null || true
		fi
	done
}

main_dev="ff:ff:ff:ff:ff:ff"
backup_line="#MASTER0_BACKUP=\"\""
updown=""
devmod="${MODE}"

# 取已记录的非空 MAC
mac1=""
mac2=""
set -- $macs
i=0
for m in $macs; do
	[ -n "$m" ] || continue
	i=$((i + 1))
	if [ "$i" -eq 1 ]; then
		mac1="$m"
	elif [ "$i" -eq 2 ]; then
		mac2="$m"
	fi
done

case "$MODE" in
	r8169)
		handoff_from_r8125
		# 原生驱动用 MAC；无 MAC 时用广播认第一块
		if [ -n "$mac1" ]; then
			main_dev="$mac1"
		fi
		if [ -n "$mac2" ]; then
			backup_line="MASTER0_BACKUP=\"${mac2}\""
		fi
		# 原生路径不需要 UPDOWN（且 unbind 后 netdev 已消失）
		updown=""
		devmod="r8169"
		;;
	generic|*)
		# 旧路径：保留 netdev 名并 ip link up
		ifaces=""
		for d in /sys/bus/pci/devices/*; do
			[ -d "$d" ] || continue
			ven=$(cat "$d/vendor" 2>/dev/null || true)
			dev=$(cat "$d/device" 2>/dev/null || true)
			[ "$ven" = "0x10ec" ] && [ "$dev" = "0x8125" ] || continue
			for nd in "$d"/net/*; do
				[ -d "$nd" ] || continue
				ifaces="${ifaces} $(basename "$nd")"
				break
			done
		done
		ifaces=$(echo "$ifaces" | sed 's/^ *//')
		if [ -n "$ifaces" ]; then
			set -- $ifaces
			main_dev="$1"
			updown="$ifaces"
			[ "$#" -ge 2 ] && backup_line="MASTER0_BACKUP=\"$2\""
		fi
		devmod="generic"
		for iface in $updown; do
			ip link set "$iface" up 2>/dev/null || true
		done
		;;
esac

cat > "${TMP}" <<EOF
# Generated by ethercat-board-conf — do not edit
MASTER0_DEVICE="${main_dev}"
${backup_line}
DEVICE_MODULES="${devmod}"
UPDOWN_INTERFACES="${updown}"
EOF

mv -f "${TMP}" "${OUT}"
echo "ethercat-board-conf: mode=${devmod} wrote ${OUT} (n=${n} main=${main_dev})"

if [ "$n" -eq 0 ]; then
	echo "ethercat-board-conf: 未发现 PCI 10ec:8125" >&2
fi
exit 0
