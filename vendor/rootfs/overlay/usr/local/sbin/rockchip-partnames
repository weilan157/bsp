#!/bin/sh
# 为 mmc GPT 分区创建 /dev/block/by-name/<PARTNAME> 符号链接
set -eu
mkdir -p /dev/block/by-name
for part in /sys/class/block/mmcblk*p[0-9]*; do
	[ -d "$part" ] || continue
	name=$(grep -m1 PARTNAME "$part/uevent" 2>/dev/null | cut -d= -f2) || true
	[ -n "${name:-}" ] || continue
	ln -sfn "/dev/$(basename "$part")" "/dev/block/by-name/$name"
done
