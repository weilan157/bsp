#!/bin/sh
# 手柄自动配对守护：手柄进入配对模式后，无需任何命令即可完成 pair+trust+connect。
#
# 逻辑：每 ~30s 扫一轮；从扫描日志里收集 "MAC + 名称"，名字像手柄的候选
# 若尚未配对就自动配对、信任并连接；配对失败则把 MAC 拉黑（本次开机内），
# 避免对同一个设备无限重试。
#
# 已配对的设备走 microduck-bt-autoconnect 的重连逻辑（每 10s）。
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

SCANLOG=/run/bt-scan.log
BLACKLIST=/run/bt-autopair.blacklist
SCAN_SECS=25

# 名字匹配（不区分大小写）。只匹配这些模式，避免误配手机/音箱。
PATTERN='xbox|gamepad|game ?pad|controller|joystick|dualshock|dualsense|8bitdo|pro controller|joy-?con|gamesir|flydigi|steam controller|stadia|shield'

log() { printf 'microduck-bt: %s\n' "$*" > /dev/kmsg 2>/dev/null; }

is_blacklisted() {
	[ -f "$BLACKLIST" ] && grep -qxF "$1" "$BLACKLIST" 2>/dev/null
}

while :; do
	if ! hciconfig 2>/dev/null | grep -q 'UP RUNNING'; then
		sleep 10
		continue
	fi

	bluetoothctl --timeout "$SCAN_SECS" scan on > "$SCANLOG" 2>&1

	# 从扫描日志提取 mac 与名称（[NEW] 行可能还没名字，[CHG] Name: 行会补上）
	awk '
		/\[NEW\][[:space:]]+Device[[:space:]]/ {
			mac = $3; name = substr($0, index($0, $3) + 18)
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", name); n[mac] = name
		}
		/\[CHG\][[:space:]]+Device[[:space:]].*Name:/ {
			mac = $3; name = $0; sub(/.*Name:[[:space:]]*/, "", name)
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", name); n[mac] = name
		}
		END { for (m in n) if (n[m] != "") printf "%s|%s\n", m, n[m] }
	' "$SCANLOG" | while IFS='|' read -r mac name; do
		[ -n "$mac" ] && [ -n "$name" ] || continue
		printf '%s' "$name" | grep -qiE "$PATTERN" || continue
		is_blacklisted "$mac" && continue

		# 已配对就交给 autoconnect 处理
		if bluetoothctl info "$mac" 2>/dev/null | grep -q 'Paired: yes'; then
			continue
		fi

		log "auto-pairing '$name' ($mac)"
		if bluetoothctl pair "$mac" 2>&1 | grep -qi 'Pairing successful'; then
			bluetoothctl trust "$mac" >/dev/null 2>&1
			bluetoothctl connect "$mac" >/dev/null 2>&1
			log "auto-paired '$name' ($mac)"
		else
			echo "$mac" >> "$BLACKLIST"
			log "auto-pair failed for '$name' ($mac), blacklisted"
		fi
	done

	sleep 5
done
