#!/bin/sh
# microduck-audio-init —— 开机给 TLV320AIC3104 设一套可用通路
#
# TLV320AIC3104 通路（HAT）：
#   播放：DAC -> HP（耳机）/ Line out
#   录音：Line1L/R 或 Mic2L/R -> PGA -> ADC
# 开机默认所有 mixer 都是关的，不设的话"能放能录但没声音"。
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

kmsg() { printf 'microduck-audio: %s\n' "$*" > /dev/kmsg 2>/dev/null || true; }

CARD="${AUDIO_CARD:-0}"

# 等声卡出现（codec 是 i2c 设备，可能比本服务晚）
i=0
while [ ! -f "/proc/asound/card$CARD/id" ] && [ $i -lt 100 ]; do
	sleep 0.1
	i=$((i + 1))
done
[ -f "/proc/asound/card$CARD/id" ] || { kmsg "没有 card$CARD"; exit 0; }

# 控件名在不同 codec 上可能有差异，逐个尝试、缺了不算错
setc() { amixer -c "$CARD" sset "$1" "$2" ${3:-} >/dev/null 2>&1 || true; }
setb() { amixer -c "$CARD" sset "$1" "$2" >/dev/null 2>&1 || true; }

# 播放：PCM 音量 + HP 输出
setc 'PCM' '80%'
setc 'HP'  '80%'
setb 'HP DAC' 'on'
setb 'Left HP Mixer DACL1'  'on'
setb 'Right HP Mixer DACR1' 'on'
setb 'Left HPCOM Mixer DACL1'  'on'
setb 'Right HPCOM Mixer DACR1' 'on'
# Line out（如果接了 Line 输出）
setb 'Line DAC' 'on'
setb 'Left Line Mixer DACL1'  'on'
setb 'Right Line Mixer DACR1' 'on'

# 录音：Line 输入 + Mic2 输入都打开，PGA 适中
setc 'Line' '70%'
setc 'PGA'  '60%' 'cap'
setb 'Left PGA Mixer Line1L' 'on'
setb 'Right PGA Mixer Line1R' 'on'
setb 'Left PGA Mixer Mic2L' 'on'
setb 'Right PGA Mixer Mic2R' 'on'
setb 'Left Line1L Mux' 'single-ended'
setb 'Right Line1R Mux' 'single-ended'

kmsg "已设置 mixer (card$CARD)"
