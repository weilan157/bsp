#!/bin/sh
# microduck-audio-init —— TLV320AIC3104 开机 mixer 设置（带重试）
#
# 背景（2026-11-01 真机定论）：之前记的"I2C 间歇性失败"其实是
# **第一次开流时，PLL 使能与 DAC/输出级上电同时发生**的瞬态把 codec 打死：
# 一旦发生，I2C 全部 ACK not received，还会把总线 SDA 拉低（连 0x6a 的 IMU
# 都读不到），只能拔电源恢复 —— 所以看起来像"偶发、热重启也不一定好"。
#
# 解决办法：开机（还没有任何流）先用 i2cset 把 PLL 按 12MHz->48kHz 的固定值
# 写好并锁住，等真正 hw_params 时驱动再写同样的值是"无变化的重复写"，
# 不再出现使能与上电同时进行的瞬态。真机验证：连续播放 20s+ 不掉线，
# 声音干净、音量正常。
#
# 下面保留重试循环（I2C 仍可能偶发失败），每轮重写并回读校验三个关键控件。
#
# 输出通路依据参考实现 + 原理图：
#   - 喇叭挂在 codec 的线输出 LEFT_LOP/RIGHT_LOP，经 U1 PAM8406 到 J1；
#     HPOUT/HPROUT 未接（插耳机孔不会响）；
#   - 'Line Playback Switch' 是 LOP 输出级静音位，必须 on；
#   - 'Line Playback Volume' 是 LOP 增益（0..9 dB）；
#   - 采集走 MIC2R（AIC3104 只有 MIC2/LINE2，没有 MIC3）。
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

kmsg() { printf 'microduck-audio: %s\n' "$*" > /dev/kmsg 2>/dev/null || true; }

CARD="${AUDIO_CARD:-0}"
i=0
while [ ! -f "/proc/asound/card$CARD/id" ] && [ $i -lt 300 ]; do
	sleep 0.1
	i=$((i + 1))
done
[ -f "/proc/asound/card$CARD/id" ] || { kmsg "没有 card$CARD"; exit 0; }

setv() { amixer -c "$CARD" cset name="$1" "$2" >/dev/null 2>&1 || amixer -c "$CARD" sset "$1" "$2" >/dev/null 2>&1 || true; }
getv() { amixer -c "$CARD" cget name="$1" 2>/dev/null | grep -m1 ': values=' | sed 's/.*: values=//'; }

# 12MHz(MCLK) -> 48kHz 的 PLL 设定：
#   codec_clk = 2048*48000/(12e6/1000) = 8192
#   j*r/p = 8.192  ->  j=4, d=960, r=2, p=1, q=2
pll_pre() {
	i2cset -y -f 7 0x18 0x65 0x00 2>/dev/null || true	# CODEC_CLKIN <- PLL
	i2cset -y -f 7 0x18 0x03 0x91 2>/dev/null || true	# PLL enable, Q=2, P=1
	i2cset -y -f 7 0x18 0x04 0x1f 2>/dev/null || true	# J=4, D MSB
	i2cset -y -f 7 0x18 0x05 0x02 2>/dev/null || true	# D LSB, R=2
	i2cset -y -f 7 0x18 0x06 0x01 2>/dev/null || true	# P=1
	sleep 0.2	# 此刻还没有数据流，给 PLL 锁定时间
}

apply_all() {
	pll_pre
	setv 'PCM Playback Volume'      '127,127'
	setv 'Line DAC Playback Volume' '118,118'
	setv 'Line Playback Switch'     'on,on'
	setv 'Line Playback Volume'     '9,9'
	setv 'Left Line Mixer DACL1'    'on'
	setv 'Right Line Mixer DACR1'   'on'
	setv 'Line DAC'                 'on'
	setv 'HP DAC Playback Volume'   '118,118'
	setv 'HP Playback Switch'       'on,on'
	# 采集（按 D1 版 Audio 原理图逐脚核对）：
	#   MK1 板载麦克风 + J2/J9 外接麦克风 -> C40/C41 1uF 耦合 ->
	#   MIC1LP/LINE1L(10)、MIC1RP/LINE1R(12)；偏置由板上 R42/R43=4k7 上拉到 +3V3，
	#   codec 的 MICBIAS(15) 只到 TP2 测试点，不参与。
	#   MIC2L/LINE2L/MICDET(14) 经 0R 出去，是插孔检测，不要拿来做采集。
	# 官方 aic3104-init.sh 用的是 'Right PGA Mixer Mic3R'，但 AIC3104 没有 MIC3
	# （0x11/0x12 读回 0xFF），那条在这颗芯片上无效 —— 这是对齐原理图后的结论。
	setv 'Left PGA Mixer Line1L'  'on'
	setv 'Right PGA Mixer Line1R' 'on'
	setv 'Left PGA Mixer Line1R'  'off'
	setv 'Right PGA Mixer Line1L' 'off'
	setv 'Left PGA Mixer Line2L'  'off'
	setv 'Left PGA Mixer Line2R'  'off'
	setv 'Right PGA Mixer Line2L' 'off'
	setv 'Right PGA Mixer Line2R' 'off'
	setv 'Right PGA Mixer Mic3R'  'off'
	setv 'Left PGA Mixer Mic3L'   'off'
	setv 'PGA Capture Switch'    'on,on'
	# 0..119 = 0..59.5dB（每步 0.5dB）。板上咪头是小信号，5dB 起步；
	# 实测 30dB 会把输入直接顶到 32767（削顶），别再回到 60。
	setv 'PGA Capture Volume'    '10,10'
}

try=0
while [ "$try" -lt 40 ]; do
	try=$((try + 1))
	apply_all

	sw=$(getv 'Line Playback Switch')
	pcm=$(getv 'PCM Playback Volume')
	ldv=$(getv 'Line Playback Volume')
	if [ "$sw" = "on,on" ] && [ "$pcm" = "127,127" ] && [ "$ldv" = "9,9" ]; then
		kmsg "mixer OK（第 $try 轮）: Line Switch=$sw PCM=$pcm LOP=$ldv"
		exit 0
	fi
	sleep 0.2
done

kmsg "40 轮重试仍未写成功（I2C 持续失败）: Line Switch=${sw:-?} PCM=${pcm:-?} LOP=${ldv:-?}"
exit 0
