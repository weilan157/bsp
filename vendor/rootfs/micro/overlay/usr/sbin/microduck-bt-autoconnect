#!/bin/sh
# 已配对/信任的蓝牙设备自动重连（手柄、键鼠、耳机等）
#
# 触发场景：
#   - 开机：手柄先开/板子先开都能连上（后台每 10s 扫一遍）
#   - 手柄断电再开：仅靠 BlueZ 的被动 page scan 不一定成功，
#     这里主动 connect，并在设备不在缓存时先做一次短扫描
# 只处理 Trusted: yes 且 Icon 是 input-* 的设备（避免去连音箱/手机）。
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

CONF=/etc/microduck/bt-autoconnect.conf
INTERVAL=10

log() { printf 'microduck-bt: %s\n' "$*" > /dev/kmsg 2>/dev/null; }

# 可选：/etc/microduck/bt-autoconnect.conf 里每行一个 MAC，只连这些
list_macs() {
	if [ -s "$CONF" ]; then
		grep -vE '^[[:space:]]*(#|$)' "$CONF" | awk '{print $1}'
		return
	fi
	# 没配置就自动挑：trusted 且 icon 为 input-* 的设备
	bluetoothctl devices 2>/dev/null | awk '{print $2}' | while read -r mac; do
		[ -n "$mac" ] || continue
		info=$(bluetoothctl info "$mac" 2>/dev/null)
		echo "$info" | grep -q 'Trusted: yes' || continue
		echo "$info" | grep -qE 'Icon: input-' || continue
		echo "$mac"
	done
}

last_state=""

while :; do
	# 适配器没上电就等
	if ! hciconfig 2>/dev/null | grep -q 'UP RUNNING'; then
		sleep "$INTERVAL"
		continue
	fi

	cands=$(list_macs)
	if [ -z "$cands" ]; then
		if [ "$last_state" != "none" ]; then
			log "no trusted input device yet (pair a gamepad first)"
			last_state="none"
		fi
		sleep "$INTERVAL"
		continue
	fi

	for mac in $cands; do
		info=$(bluetoothctl info "$mac" 2>/dev/null)
		if echo "$info" | grep -q 'Connected: yes'; then
			continue
		fi

		# 设备不在缓存里（例如 bluetoothd 重启后），先短扫一下把它找回来
		if ! echo "$info" | grep -q 'Device '; then
			bluetoothctl --timeout 8 scan on >/dev/null 2>&1
		fi

		out=$(bluetoothctl connect "$mac" 2>&1)
		if echo "$out" | grep -qi 'Connection successful'; then
			log "auto-connected $mac"
			last_state="connected"
		else
			# 只在状态变化时打日志，避免每 10s 刷屏
			if [ "$last_state" != "fail:$mac" ]; then
				log "connect $mac failed: $(echo "$out" | tail -1)"
				last_state="fail:$mac"
			fi
		fi
	done
	sleep "$INTERVAL"
done
