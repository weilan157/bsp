#!/bin/sh
# 启动 SSH 服务（Debian openssh-server）
#
# 我们的 inittab 只跑 `sysinit: rcS`，不走 rc2.d，所以 Debian 安装的
# /etc/init.d/ssh 不会被自动调用，这里显式拉起。
# 主机密钥在镜像里是空的（chroot 里不该生成），首次启动用 ssh-keygen -A 补齐。
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

kmsg() { printf 'microduck: %s\n' "$*" > /dev/kmsg 2>/dev/null; }

[ -x /usr/sbin/sshd ] || { kmsg "sshd not installed"; exit 0; }

mkdir -p /run/sshd /etc/ssh 2>/dev/null
chmod 755 /run/sshd 2>/dev/null

# 首次启动生成主机密钥（约 1s）
if [ ! -f /etc/ssh/ssh_host_ed25519_key ]; then
	ssh-keygen -A >/dev/null 2>&1
	kmsg "ssh host keys generated"
fi

# 已经跑着就不重复启动
if pidof sshd >/dev/null 2>&1; then
	exit 0
fi

/usr/sbin/sshd
if pidof sshd >/dev/null 2>&1; then
	kmsg "sshd started"
else
	kmsg "sshd failed to start"
fi
