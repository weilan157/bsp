#!/bin/sh
# 首次启动把 rootfs 扩到整张 SD 卡
#
# 顺序很关键（踩过的坑都写在注释里）：
#   0) 先解析真实块设备：/proc/mounts 里 root 是 /dev/root（非块设备），
#      旧脚本在这里 exit 0，导致扩容从未执行；
#   1) 把 GPT 备份头搬到卡尾（sgdisk -e）。镜像里的 GPT 备份头在镜像末尾，
#      header 的 last usable LBA 也停在那里；不先搬走，sfdisk `,+,` 只能扩到
#      镜像末尾附近（29.7G 卡实测只到 4xx MB）；
#   2) sfdisk `,+,` 扩分区（对已挂载分区走 BLKPG，不需要重读分区表）；
#   3) resize2fs 扩文件系统。
dev=$(awk '$2=="/"{print $1}' /proc/mounts | head -1)
if [ ! -b "$dev" ]; then
	dev=$(sed -n 's/.*[[:space:]]root=\([^[:space:]]*\).*/\1/p' /proc/cmdline | head -1)
fi
[ -b "$dev" ] || dev=/dev/mmcblk0p2
[ -b "$dev" ] || exit 0

printf 'microduck: grow target %s\n' "$dev" > /dev/kmsg 2>/dev/null

case "$dev" in
	*/mmcblk*p[0-9]*) disk=${dev%p[0-9]*}; part=${dev##*p} ;;
	*/sd[a-z][0-9]*)  disk=$(printf '%s' "$dev" | sed 's/[0-9]*$//'); part=$(printf '%s' "$dev" | sed 's/.*[a-z]//') ;;
	*) exit 0 ;;
esac

kmsg() { printf 'microduck: %s\n' "$*" > /dev/kmsg 2>/dev/null; }

# 分区当前结束扇区（start + size）
part_end() {
	set -- $(cat "/sys/class/block/$(basename "$dev")/start" \
		"/sys/class/block/$(basename "$dev")/size" 2>/dev/null)
	[ $# -eq 2 ] && echo $(( $1 + $2 ))
}

disk_sectors() {
	s=$(cat "/sys/class/block/$(basename "$disk")/size" 2>/dev/null)
	[ -n "$s" ] || s=$(blockdev --getsz "$disk" 2>/dev/null)
	echo "$s"
}

# 1) 搬 GPT 备份头到卡尾
move_gpt_backup() {
	if command -v sgdisk >/dev/null 2>&1; then
		if sgdisk -e "$disk" >/dev/null 2>&1; then
			kmsg "GPT 备份头已搬到卡尾 (sgdisk -e)"
			return 0
		fi
		kmsg "sgdisk -e 失败"
	fi
	if command -v parted >/dev/null 2>&1; then
		printf 'Fix\n' | parted ---pretend-input-tty "$disk" print >/dev/null 2>&1 && \
			kmsg "GPT 备份头已搬到卡尾 (parted Fix)"
	fi
	return 0
}

# 2) 扩分区
grow_partition() {
	disk_end=$(disk_sectors)
	[ -n "$disk_end" ] && [ "$disk_end" -gt 0 ] || return 1

	cur=$(part_end)
	kmsg "分区结束于 ${cur:-?} / 磁盘 ${disk_end} 扇区"

	# 已经没有空闲（差的少于 1 MiB）就直接返回
	if [ -n "$cur" ] && [ $((disk_end - cur)) -lt 2048 ]; then
		kmsg "分区已到卡尾，无需扩"
		return 0
	fi

	move_gpt_backup

	if command -v sfdisk >/dev/null 2>&1; then
		if printf ',+,\n' | sfdisk --force --no-reread -N "$part" "$disk" >/dev/null 2>&1; then
			cur=$(part_end)
			if [ -n "$cur" ] && [ $((disk_end - cur)) -lt 2048 ]; then
				kmsg "分区已扩到卡尾: $cur 扇区"
				return 0
			fi
			kmsg "sfdisk 只扩到 ${cur} 扇区（磁盘 $disk_end），再搬一次 GPT 后重试"
			move_gpt_backup
			printf ',+,\n' | sfdisk --force --no-reread -N "$part" "$disk" >/dev/null 2>&1
			cur=$(part_end)
			if [ -n "$cur" ] && [ $((disk_end - cur)) -lt 2048 ]; then
				kmsg "分区已扩到卡尾: $cur 扇区"
				return 0
			fi
			kmsg "sfdisk 扩分区仍不完整: $cur / $disk_end"
		else
			kmsg "sfdisk 扩分区失败"
		fi
	fi

	if command -v parted >/dev/null 2>&1; then
		parted -s "$disk" unit s resizepart "$part" "$((disk_end - 1))s" >/dev/null 2>&1 && {
			kmsg "分区已用 parted 扩到 $((disk_end - 1))s"
			return 0
		}
	fi
	return 1
}

grow_partition || kmsg "分区扩容失败"

# 3) 扩文件系统
bs=$(dumpe2fs -h "$dev" 2>/dev/null | awk -F: '/^Block size/{gsub(/ /,"",$2);print $2}')
fs_blocks=$(dumpe2fs -h "$dev" 2>/dev/null | awk -F: '/^Block count/{gsub(/ /,"",$2);print $2}')
size_bytes=$(blockdev --getsize64 "$dev" 2>/dev/null) || exit 0

[ -n "$bs" ] && [ -n "$fs_blocks" ] && [ -n "$size_bytes" ] || exit 0
part_blocks=$((size_bytes / bs))
[ "$fs_blocks" -lt "$part_blocks" ] || exit 0

if resize2fs "$dev" >/dev/null 2>&1; then
	printf 'microduck: rootfs resized %s -> %s blocks\n' "$fs_blocks" "$part_blocks" > /dev/kmsg 2>/dev/null
fi
