#!/bin/sh
# 首次启动把 rootfs 扩到整张 SD 卡
#  1) 用 parted 把 p2 分区扩到磁盘末尾（在线 BLKPG，不需要重读分区表）；
#  2) 再用 resize2fs 把 ext4 扩到分区大小。
# 旧版本只做了第 2 步，而镜像里的 p2 本身只有 rootfs 那么大（打包时按
# rootfs.ext4 尺寸写的），SD 卡剩余空间永远用不上，apt 就会
# "No space left on device"。
dev=$(awk '$2=="/"{print $1}' /proc/mounts | head -1)
# 内核 cmdline 是 root=/dev/mmcblk0p2，但 /proc/mounts 里会显示成 /dev/root，
# 那不是块设备，旧脚本在这里 `exit 0` 静默退出，所以分区从来没扩过。
# 依次兜底：/proc/cmdline 的 root= → 常见 SD 分区。
if [ ! -b "$dev" ]; then
	dev=$(sed -n 's/.*[[:space:]]root=\([^[:space:]]*\).*/\1/p' /proc/cmdline | head -1)
fi
[ -b "$dev" ] || dev=/dev/mmcblk0p2
[ -b "$dev" ] || exit 0

printf 'microduck: grow target %s\n' "$dev" > /dev/kmsg 2>/dev/null

case "$dev" in
	*/mmcblk*p[0-9]*) disk=${dev%p[0-9]*}; part=${dev##*p} ;;
	*/sd[a-z][0-9]*)  disk=$(printf '%s' "$dev" | sed 's/[0-9]*$//'); part=$(printf '%s' "$dev" | sed 's/.*[a-z]//') ;;
	*) exit 0 ;;
esac

# 1) 扩分区
#
# 踩过的坑（按顺序）：
#   a) /proc/mounts 里 root 是 /dev/root（不是块设备）→ 旧脚本直接 exit；
#   b) 镜像的 GPT 备份头在 p2 末尾，parted 提示 "fix the GPT"；
#   c) 即使修了 GPT，parted resizepart 仍报
#      "Unable to satisfy all constraints on the partition"（对齐/备份头约束）。
# 现在优先用 sfdisk（growpart 的标准做法，对已挂载分区走 BLKPG）：
#     printf ',+,\n' | sfdisk --force --no-reread -N <part> <disk>
# sfdisk 不可用时再退回 parted。
grow_partition() {
	if command -v sfdisk >/dev/null 2>&1; then
		if printf ',+,\n' | sfdisk --force --no-reread -N "$part" "$disk" \
			> /dev/null 2>&1; then
			printf 'microduck: partition %s extended with sfdisk\n' "$dev" > /dev/kmsg 2>/dev/null
			return 0
		fi
		printf 'microduck: sfdisk extend failed\n' > /dev/kmsg 2>/dev/null
	fi

	if command -v parted >/dev/null 2>&1; then
		# 注意不能用 parted -s：脚本模式会抑制 "you can fix the GPT ..."
		# 这条警告，grep 永远匹配不到，备份头也就不会被移动。
		if parted "$disk" print 2>&1 | grep -qi 'fix the GPT'; then
			printf 'Fix\n' | parted ---pretend-input-tty "$disk" print >/dev/null 2>&1
		fi
		sectors=$(cat "/sys/class/block/$(basename "$disk")/size" 2>/dev/null)
		[ -n "$sectors" ] || sectors=$(blockdev --getsz "$disk" 2>/dev/null)
		if [ -n "$sectors" ] && [ "$sectors" -gt 0 ]; then
			parted -s "$disk" unit s resizepart "$part" "$((sectors - 1))s" \
				> /dev/null 2>&1 && {
				printf 'microduck: partition %s extended with parted\n' "$dev" > /dev/kmsg 2>/dev/null
				return 0
			}
		fi
	fi
	return 1
}

grow_partition || printf 'microduck: partition grow skipped/failed\n' > /dev/kmsg 2>/dev/null

# 2) 扩文件系统
bs=$(dumpe2fs -h "$dev" 2>/dev/null | awk -F: '/^Block size/{gsub(/ /,"",$2);print $2}')
fs_blocks=$(dumpe2fs -h "$dev" 2>/dev/null | awk -F: '/^Block count/{gsub(/ /,"",$2);print $2}')
size_bytes=$(blockdev --getsize64 "$dev" 2>/dev/null) || exit 0

[ -n "$bs" ] && [ -n "$fs_blocks" ] && [ -n "$size_bytes" ] || exit 0
part_blocks=$((size_bytes / bs))
[ "$fs_blocks" -lt "$part_blocks" ] || exit 0

if resize2fs "$dev" >/dev/null 2>&1; then
	printf 'microduck: rootfs resized %s -> %s blocks\n' "$fs_blocks" "$part_blocks" > /dev/kmsg 2>/dev/null
fi
