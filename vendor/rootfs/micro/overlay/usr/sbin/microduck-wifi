#!/bin/sh
# 后台：加载 WiFi/BT/摄像头驱动，有 SSID 配置才连网
/usr/sbin/modprobe bcmdhd   2>/dev/null
/usr/sbin/modprobe hci_uart 2>/dev/null
/usr/sbin/modprobe ov5695   2>/dev/null

CONF=/etc/wpa_supplicant/wpa_supplicant.conf
[ -f "$CONF" ] || exit 0
grep -q '^[[:space:]]*network=' "$CONF" || exit 0

# 等 wlan0 出现（bcmdhd 异步 probe）
i=0
while [ ! -e /sys/class/net/wlan0 ] && [ $i -lt 30 ]; do
	sleep 0.1
	i=$((i + 1))
done
[ -e /sys/class/net/wlan0 ] || exit 0

/usr/sbin/ip link set wlan0 up 2>/dev/null || exit 0
/usr/sbin/wpa_supplicant -B -i wlan0 -c "$CONF" 2>/dev/null || exit 0
busybox udhcpc -i wlan0 -b -q -t 5 -T 2 >/dev/null 2>&1 || true

printf 'microduck: wlan0 up at %ss\n' "$(cut -d' ' -f1 /proc/uptime)" > /dev/kmsg 2>/dev/null
