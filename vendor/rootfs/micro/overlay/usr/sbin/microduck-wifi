#!/bin/sh
# 后台：加载驱动 → 尝试连接已保存的 WiFi → 连不上就开 AP 配网热点
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

if [ -f /etc/microduck-modules ]; then
	while read -r m; do
		case "$m" in
			''|\#*) continue ;;
		esac
		modprobe "$m" 2>/dev/null
	done < /etc/microduck-modules
fi

CONF=/etc/wpa_supplicant/wpa_supplicant.conf

# Radxa 的 aic 驱动是「加载器 + 驱动」两段式：aic_load_fw 先把固件灌进去，
# 芯片会 soft disconnect 并重新枚举成 a69c:8d81，然后 aic8800_fdrv 才建 wlan0。
# 所以这里要等 wlan0 出现，最多 10 秒。
i=0
while [ ! -e /sys/class/net/wlan0 ] && [ $i -lt 100 ]; do
	sleep 0.1
	i=$((i + 1))
done
if [ ! -e /sys/class/net/wlan0 ]; then
	printf 'microduck: wlan0 never appeared\n' > /dev/kmsg 2>/dev/null
	exit 0
fi

start_ap() {
	/usr/sbin/microduck-ap
}

# 没有配置（或强制 AP 模式）→ 直接开热点配网
if [ ! -f "$CONF" ] || ! grep -q '^[[:space:]]*network=' "$CONF" \
	|| [ -f /etc/microduck/ap-first ]; then
	printf 'microduck: no wifi config, starting AP portal\n' > /dev/kmsg 2>/dev/null
	start_ap
	exit 0
fi

ip link set wlan0 up 2>/dev/null
rm -f /run/wpa_supplicant/wlan0 2>/dev/null
mkdir -p /run/wpa_supplicant 2>/dev/null
wpa_supplicant -B -i wlan0 -c "$CONF" 2>/dev/null

# 等关联 + 四次握手（最多 25 秒）
i=0
while [ $i -lt 50 ]; do
	wpa_cli -p /run/wpa_supplicant -i wlan0 status 2>/dev/null \
		| grep -q 'wpa_state=COMPLETED' && break
	sleep 0.5
	i=$((i + 1))
done

if wpa_cli -p /run/wpa_supplicant -i wlan0 status 2>/dev/null | grep -q 'wpa_state=COMPLETED'; then
	printf 'microduck: wifi associated at %ss\n' "$(cut -d' ' -f1 /proc/uptime)" > /dev/kmsg 2>/dev/null
	busybox udhcpc -i wlan0 -b -q -t 5 -T 2 -s /usr/share/udhcpc/default.script >/dev/null 2>&1 || true
	printf 'microduck: dhcp done at %ss\n' "$(cut -d' ' -f1 /proc/uptime)" > /dev/kmsg 2>/dev/null
	# 板子没有 RTC 电池，联网后校时（否则 apt 签名/TLS 都会因时间错误失败）
	/usr/sbin/microduck-timesync >/dev/null 2>&1 &
else
	# 连不上（密码错 / AP 不在范围）→ 回退到 AP 配网
	printf 'microduck: wifi NOT associated, falling back to AP portal\n' > /dev/kmsg 2>/dev/null
	pkill -f wpa_supplicant 2>/dev/null
	start_ap
fi
