#!/bin/sh
# 后台：加载驱动 → 尝试连接已保存的 WiFi → 连不上就开 AP 配网热点
#
# 相比旧版的改进：
#   - AP 模式期间仍会周期性重试 STA：路由器恢复/密码改对后自动切回联网，
#     不用再手动重启；
#   - STA 连上后如果断线，也会自动重连（watchdog）；
#   - 各阶段都往 /dev/kmsg 打点，便于看启动耗时与状态。
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

CONF=/etc/wpa_supplicant/wpa_supplicant.conf

# 网卡名：systemd/udev 的「可预测网卡名」会把 wlan0 改成 wlx<mac>，
# 所以这里不能写死。优先 wlan0（我们 udev 规则会改名回来），
# 否则取第一个 wl* 接口。
wifi_if() {
	if [ -e /sys/class/net/wlan0 ]; then
		echo wlan0
		return
	fi
	for d in /sys/class/net/wl*; do
		[ -e "$d" ] || continue
		basename "$d"
		return
	done
	echo wlan0
}
# 注意：不能在启动时就算死接口名 —— 那时驱动还没建出网卡。
# 先轮询等任意 wl*/wlan0 出现，再定名。
i=0
while [ $i -lt 150 ]; do
	for d in /sys/class/net/wlan0 /sys/class/net/wl*; do
		[ -e "$d" ] && break 2
	done
	sleep 0.1
	i=$((i + 1))
done
WIFI_IF=$(wifi_if)
STA_RETRY_INTERVAL=30
STA_WAIT=25

kmsg() { printf 'microduck: %s\n' "$*" > /dev/kmsg 2>/dev/null; }

# ---- 驱动 ----
if [ -f /etc/microduck-modules ]; then
	while read -r m; do
		case "$m" in
			''|\#*) continue ;;
		esac
		modprobe "$m" 2>/dev/null
	done < /etc/microduck-modules
fi

# Radxa 的 aic 驱动是「加载器 + 驱动」两段式：aic_load_fw 灌完固件后芯片会
# 重新枚举成 a69c:8d81，然后 aic8800_fdrv 才建 wlan0。最多等 10 秒。
if [ ! -e "/sys/class/net/$WIFI_IF" ]; then
	kmsg "wlan0 never appeared"
	exit 0
fi
kmsg "$WIFI_IF appeared at $(cut -d' ' -f1 /proc/uptime)s"

has_config() {
	[ -f "$CONF" ] && grep -q '^[[:space:]]*network=' "$CONF"
}

# 尝试 STA 连接，成功返回 0
try_sta() {
	has_config || return 1
	[ -f /etc/microduck/ap-first ] && return 1

	# AP 还开着就先关掉，否则同 phy 上 AP+STA 需要同信道
	if [ -f /run/microduck-ap.pid ]; then
		stop_ap
	fi

	ip link set "$WIFI_IF" up 2>/dev/null
	rm -f "/run/wpa_supplicant/$WIFI_IF" 2>/dev/null
	mkdir -p /run/wpa_supplicant 2>/dev/null
	pkill -f "wpa_supplicant.*$WIFI_IF" 2>/dev/null
	wpa_supplicant -B -i "$WIFI_IF" -c "$CONF" 2>/dev/null

	i=0
	while [ $i -lt $((STA_WAIT * 2)) ]; do
		wpa_cli -p /run/wpa_supplicant -i "$WIFI_IF" status 2>/dev/null \
			| grep -q 'wpa_state=COMPLETED' && break
		sleep 0.5
		i=$((i + 1))
	done

	if wpa_cli -p /run/wpa_supplicant -i "$WIFI_IF" status 2>/dev/null \
		| grep -q 'wpa_state=COMPLETED'; then
		busybox udhcpc -i "$WIFI_IF" -b -q -t 5 -T 2 \
			-s /usr/share/udhcpc/default.script >/dev/null 2>&1 || true
		kmsg "wifi associated at $(cut -d' ' -f1 /proc/uptime)s"
		/usr/sbin/microduck-timesync >/dev/null 2>&1 &
		return 0
	fi
	pkill -f "wpa_supplicant.*$WIFI_IF" 2>/dev/null
	return 1
}

start_ap() {
	/usr/sbin/microduck-ap start
	# 记录 AP 状态，供 try_sta 判断是否需要先关热点
	: > /run/microduck-ap.pid
}

stop_ap() {
	# 平台实现优先（A733 的 microduck-ap 支持 start/stop，AP+STA 共存时会用 ap0）
	[ -x /usr/sbin/microduck-ap ] && /usr/sbin/microduck-ap stop >/dev/null 2>&1
	pkill -x dnsmasq 2>/dev/null
	pkill -x hostapd 2>/dev/null
	pkill -f 'busybox httpd' 2>/dev/null
	rm -f /run/microduck-ap.pid
	sleep 1
	# 清掉可能被 AP 模式改过的接口状态（ap0 由平台脚本删，这里兜底 wlan0）
	ip addr flush dev "$WIFI_IF" 2>/dev/null
	iw dev "$WIFI_IF" set type managed 2>/dev/null
	ip link set "$WIFI_IF" up 2>/dev/null
}

# ---- 主流程 ----
if try_sta; then
	kmsg "online"
	# AP+STA 共存：连上 STA 后再拉起热点（ap0 独立 vif，驱动 CONFIG_MCC=y）。
	# 必须在 STA 成功之后做：hostapd 绑定 phy 时 wlan0 得已经 up 且关联。
	if grep -q '^ENABLED=1' /etc/microduck/ap.conf 2>/dev/null; then
		if /usr/sbin/microduck-ap start >/dev/null 2>&1; then
			kmsg "AP+STA coexist enabled ($(sed -n 's/^ADDR=//p' /etc/microduck/ap.conf))"
			: > /run/microduck-ap.pid
		else
			kmsg "AP+STA coexist failed (see dmesg)"
		fi
	fi
else
	kmsg "STA failed / no config, starting AP portal"
	start_ap
	# AP 期间持续重试 STA（每 30s），成功就切回联网模式
	while :; do
		sleep "$STA_RETRY_INTERVAL"
		if try_sta; then
			kmsg "STA ok while AP was up, AP stopped"
			break
		fi
		# try_sta 失败时可能把 AP 关了（它开头会 stop_ap），重新拉起
		if [ ! -f /run/microduck-ap.pid ]; then
			start_ap
		fi
	done
fi

# ---- 联网后 watchdog：掉线自动重连 ----
while :; do
	sleep "$STA_RETRY_INTERVAL"
	if ! wpa_cli -p /run/wpa_supplicant -i "$WIFI_IF" status 2>/dev/null \
		| grep -q 'wpa_state=COMPLETED'; then
		kmsg "link lost, reconnecting"
		try_sta || true
	fi
done
