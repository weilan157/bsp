#!/bin/sh
# microduck-audio-probe —— 播放时抓 codec 关键寄存器 + 时钟树 + mixer 状态
#
# 注意：codec 现在挂在 i2c-gpio 上，总线号不再是 7，所以 regmap 路径
# 必须动态发现（0-0018 / 7-0018 都可能），否则读到空文件还以为"寄存器都是 0"。
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
C=${AUDIO_CARD:-0}

echo "===== 0) codec 挂在哪条 I2C 上 ====="
DEV=$(ls /sys/bus/i2c/devices/ 2>/dev/null | grep -E '^[0-9]+-0018$' | head -1)
echo "device = ${DEV:-<未找到>}"
BUS=$(echo "${DEV:-0-0018}" | cut -d- -f1)
echo "bus    = i2c-$BUS"
REGMAP=$(ls -d /sys/kernel/debug/regmap/*0018* 2>/dev/null | head -1)
echo "regmap = ${REGMAP:-<无>}"

echo
echo "===== 1) 播放时抓 hw_params ====="
speaker-test -D "hw:$C,0" -c 2 -t sine -f 440 -l 1 >/dev/null 2>&1 &
ST=$!
sleep 1.5
cat /proc/asound/card$C/pcm0p/sub0/hw_params 2>/dev/null
wait $ST 2>/dev/null

echo
echo "===== 2) mixer 关键项 ====="
for n in 'PCM Playback Volume' 'Line DAC Playback Volume' 'Line Playback Switch' \
         'Line Playback Volume' 'HP Playback Switch' 'HP DAC Playback Volume'; do
	v=$(amixer -c "$C" cget name="$n" 2>/dev/null | grep -m1 ': values=' | sed 's/.*: values=//')
	[ -n "$v" ] && printf '%-28s %s\n' "$n" "$v"
done

echo
echo "===== 3) codec 寄存器快照 ====="
if [ -n "${REGMAP:-}" ] && [ -f "$REGMAP/registers" ]; then
	# regmap 每行 16 字节：00: .. / 10: .. / ...
	head -8 "$REGMAP/registers"
else
	echo "(没有 regmap debugfs，改用解绑驱动后直接 i2cget)"
fi

echo
echo "===== 4) 直接问芯片「你还在吗」（解绑驱动，纯软件）====="
DRV=/sys/bus/i2c/drivers/tlv320aic3x
if [ -n "${DEV:-}" ] && [ -d "$DRV" ]; then
	echo "$DEV" > "$DRV/unbind" 2>/dev/null && sleep 0.3
	for a in 02 03 08 09 0b; do
		v=$(i2cget -y "$BUS" 0x18 0x$a 2>&1)
		printf 'reg 0x%s -> %s\n' "$a" "$v"
	done
	echo "$DEV" > "$DRV/bind" 2>/dev/null
	echo "(已重新绑定驱动)"
else
	echo "找不到驱动 $DRV 或设备，跳过"
fi

echo
echo "===== 5) I2S / audio 时钟 ====="
grep -iE 'i2s0|pll-audio' /sys/kernel/debug/clk/clk_summary 2>/dev/null | head -12 || \
	echo "(clk_summary 不可用)"

echo
echo "===== 6) 最近 NAK 计数 ====="
echo "NAK bailout = $(dmesg | grep -c 'NAK bailout')"

echo
echo "===== 判读 ====="
cat <<'EOF'
第 4 段是决定性证据：
- 解绑驱动后 i2cget 能读到真实值（如 0x02=0x00、0x03=0x11）：
  芯片本身活着且应答，问题在驱动/寄存器写入序列。
- 全部返回 "Error: Read failed / NAK" ：
  芯片在这条总线上不再应答 —— 与驱动配置无关，是 codec 侧（供电/复位/时钟）
  或板级连线的问题，软件无法绕过。
- 返回 "Device or resource busy"：说明解绑没成功，重跑一次。
EOF
