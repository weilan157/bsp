#!/bin/sh
# 蓝牙开机初始化：dbus → bluetoothd → rfkill 放行 → power on + pairable
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# aic_btusb 由 microduck-wifi 按 /etc/microduck-modules 加载；这里等 hci 出现。
i=0
while [ ! -e /sys/class/bluetooth/hci0 ] && [ $i -lt 100 ]; do
	sleep 0.1
	i=$((i + 1))
done
if [ ! -e /sys/class/bluetooth/hci0 ]; then
	printf 'microduck: no hci0, bluetooth not initialized\n' > /dev/kmsg 2>/dev/null
	exit 0
fi

# D-Bus 系统总线（bluetoothd 依赖）
mkdir -p /run/dbus
if [ ! -S /run/dbus/system_bus_socket ]; then
	dbus-daemon --system --fork 2>/dev/null
	sleep 1
fi

# bluetoothd（后台）
if ! pidof bluetoothd >/dev/null 2>&1; then
	bluetoothd -n >/dev/null 2>&1 &
	sleep 1
fi

# rfkill 放行 + 上电 + 可配对
rfkill unblock bluetooth 2>/dev/null
hciconfig hci0 up 2>/dev/null

if command -v bluetoothctl >/dev/null 2>&1; then
	{
		sleep 1
		echo "power on"
		sleep 1
		echo "pairable on"
		sleep 1
		echo "discoverable on"
		sleep 1
		echo "quit"
	} | bluetoothctl >/dev/null 2>&1
fi

printf 'microduck: bluetooth ready (hci0) at %ss\n' "$(cut -d' ' -f1 /proc/uptime)" > /dev/kmsg 2>/dev/null

# 已配对设备（手柄/键鼠/耳机）自动重连：后台每 10s 尝试一次
if [ -x /usr/sbin/microduck-bt-autoconnect ]; then
	if ! pidof microduck-bt-autoconnect >/dev/null 2>&1; then
		/usr/sbin/microduck-bt-autoconnect >/dev/null 2>&1 &
	fi
fi
