#!/bin/sh
# microduck-i2c-recover —— 把卡死的 TLV320AIC3104 从 I2C 总线上救回来
#
# 背景：codec 在传输中途卡住后会把 SDA/SCL 拖住，之后所有寄存器访问
# 都是 NAK（真机验证：恢复前 0/5 可读，恢复后 5/5）。
# 做法：解绑 i2c-gpio 释放引脚 -> 打 9 个 SCL 时钟 + STOP -> 重新绑定。
#
# 注意：解绑会让声卡被销毁、重绑后重建，所以**不要在开机早期跑**
# （那时 codec 还没 power-up 完成，而且会把声卡弄没）。
# 恢复成功后会重启 microduck-audio 把 mixer 重新设一遍。
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

PLAT=/sys/bus/platform/drivers/i2c-gpio
DEV=i2c-gpio-codec
I2CDRV=/sys/bus/i2c/drivers/tlv320aic3x
SLV=0-0018
SCL=${SCL_LINE:-310}
SDA=${SDA_LINE:-311}

say() { printf 'i2c-recover: %s\n' "$*"; }

probe_once() {
	BUS=$(echo "$SLV" | cut -d- -f1)
	echo "$SLV" > "$I2CDRV/unbind" 2>/dev/null
	sleep 0.2
	ok=0
	for a in 02 03 08 09 0b; do
		v=$(i2cget -y "$BUS" 0x18 "0x$a" 2>&1)
		printf '   reg 0x%s -> %s\n' "$a" "$v"
		case "$v" in Error*) ;; *) ok=$((ok + 1)) ;; esac
	done
	echo "$SLV" > "$I2CDRV/bind" 2>/dev/null
	[ "$ok" -gt 0 ]
}

try=0
while [ "$try" -lt 3 ]; do
	try=$((try + 1))
	say "第 $try 次：解绑 i2c-gpio"
	echo "$DEV" > "$PLAT/unbind" 2>/dev/null
	sleep 0.3

	say "打 9 个 SCL 时钟 + STOP (SCL=$SCL SDA=$SDA)"
	i2c-recover "$SCL" "$SDA"

	say "重新绑定 i2c-gpio"
	echo "$DEV" > "$PLAT/bind" 2>/dev/null
	sleep 0.6
	[ -e "/sys/bus/i2c/devices/$SLV" ] && echo "$SLV" > "$I2CDRV/bind" 2>/dev/null
	sleep 0.2

	say "验证"
	if probe_once; then
		say "OK：芯片已恢复应答（第 $try 次）"
		systemctl restart microduck-audio 2>/dev/null && say "已重新应用 mixer"
		exit 0
	fi
	sleep 0.5
done

say "3 次尝试后仍无应答 —— 需要查 codec 供电/复位/晶振（硬件层面）"
exit 1
