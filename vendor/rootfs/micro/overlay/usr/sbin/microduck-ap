#!/bin/sh
# 启动 AP 配网热点：hostapd + dnsmasq + busybox httpd
# 由 microduck-wifi 在「没有配置」或「STA 连不上」时调用。
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

. /etc/microduck/ap.conf

echo "microduck: starting AP portal (${AP_SSID})" > /dev/kmsg 2>/dev/null

# 停掉 STA 相关
pkill -f wpa_supplicant 2>/dev/null
pkill -x hostapd 2>/dev/null
pkill -x dnsmasq 2>/dev/null
pkill -f 'busybox httpd' 2>/dev/null
sleep 1

ip link set wlan0 down 2>/dev/null
# AIC 驱动支持 AP iftype（rwnx_cfg80211_start_ap）
iw dev wlan0 set type __ap 2>/dev/null
ip link set wlan0 up 2>/dev/null
ip addr flush dev wlan0 2>/dev/null
ip addr add "${AP_IP}/24" dev wlan0 2>/dev/null

cat > /tmp/hostapd.conf <<EOF
interface=wlan0
driver=nl80211
ctrl_interface=/run/hostapd
ssid=${AP_SSID}
hw_mode=g
channel=${AP_CHANNEL}
wpa=2
wpa_passphrase=${AP_PASS}
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
auth_algs=1
ignore_broadcast_ssid=0
EOF

if hostapd -B /tmp/hostapd.conf; then
	echo "microduck: hostapd up, ssid=${AP_SSID} pass=${AP_PASS}" > /dev/kmsg 2>/dev/null
else
	echo "microduck: hostapd failed, AP portal unavailable" > /dev/kmsg 2>/dev/null
	return 1 2>/dev/null || exit 1
fi

cat > /tmp/dnsmasq.conf <<EOF
interface=wlan0
bind-interfaces
dhcp-range=192.168.4.10,192.168.4.100,255.255.255.0,12h
dhcp-option=3,${AP_IP}
dhcp-option=6,${AP_IP}
# 把所有域名都解析到本机，形成 captive portal 效果
address=/#/${AP_IP}
EOF
dnsmasq -C /tmp/dnsmasq.conf 2>/dev/null

# 网页配网：busybox httpd + CGI
busybox httpd -p 80 -h /www 2>/dev/null
echo "microduck: AP portal ready at http://${AP_IP}/" > /dev/kmsg 2>/dev/null
