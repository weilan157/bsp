#!/bin/sh
# microduck 启动脚本：只做挂载 -> ZRAM -> 后台扩容/联网
PATH=/sbin:/bin:/usr/sbin:/usr/bin

up() { cut -d' ' -f1 /proc/uptime; }

mount -t proc   proc   /proc   2>/dev/null
mount -t sysfs  sysfs  /sys    2>/dev/null
mkdir -p /dev/pts /dev/shm /run /tmp
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs  tmpfs  /dev/shm 2>/dev/null
mount -t tmpfs  tmpfs  /run     2>/dev/null
mount -t tmpfs  tmpfs  /tmp     2>/dev/null
printf 'microduck: mounts done at %ss\n' "$(up)" > /dev/kmsg 2>/dev/null

# ZRAM swap：前台，毫秒级
/usr/sbin/microduck-zram
printf 'microduck: zram at %ss\n' "$(up)" > /dev/kmsg 2>/dev/null

# 扩容 + 驱动/WiFi 全部放后台，不阻塞登录
/usr/sbin/microduck-grow >/dev/null 2>&1 &
/usr/sbin/microduck-wifi >/dev/null 2>&1 &

# 平台钩子（A733：udev / sshd / avahi / 配网 / 手柄热插拔）
for h in /etc/microduck/rc.d/*.sh; do
	[ -x "$h" ] && "$h"
done

# 启动耗时打点（dmesg 里看）
printf 'microduck: userspace ready in %ss\n' "$(up)" > /dev/kmsg 2>/dev/null
echo "microduck ready in $(up)s" > /dev/console 2>/dev/null
