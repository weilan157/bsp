# r8125: honor CONFIG_R8125=y (was hardcoded obj-m → never in Image, no .ko)

diff --git a/drivers/net/ethernet/realtek/r8125/Makefile b/drivers/net/ethernet/realtek/r8125/Makefile
index 7e000ddf6..02894cdc9 100755
--- a/drivers/net/ethernet/realtek/r8125/Makefile
+++ b/drivers/net/ethernet/realtek/r8125/Makefile
@@ -55,7 +55,8 @@ ENABLE_PAGE_REUSE = n
 ENABLE_RX_PACKET_FRAGMENT = n
 
 ifneq ($(KERNELRELEASE),)
-	obj-m := r8125.o
+	# Use CONFIG_R8125 (y/m). Hardcoded obj-m made =y never link into vmlinux.
+	obj-$(CONFIG_R8125) := r8125.o
 	r8125-objs := r8125_n.o rtl_eeprom.o rtltool.o
 	ifeq ($(CONFIG_SOC_LAN), y)
 		EXTRA_CFLAGS += -DCONFIG_SOC_LAN
