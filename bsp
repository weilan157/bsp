#!/bin/bash
# Orange Pi Ky X1 BSP 唯一构建入口（框架兼容 rockchip-bsp）
# 用法: ./bsp <command> [options]

set -euo pipefail

BSP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_DIR="${BSP_ROOT}/scripts"
CONFIG_FILE="${BSP_ROOT}/config.env"
CONFIG_EXAMPLE="${BSP_ROOT}/config.env.example"

usage() {
	cat <<'EOF'
用法: ./bsp <command> [options]

Orange Pi R2S（Ky X1）BSP。交叉工具链: riscv64-unknown-linux-gnu-

命令:
  env [--host-tools] [--skip-toolchain] [--update]
                         安装主机依赖并下载 Ky toolchain
  config [KEY[=VALUE]]   查看/读取/写入 config.env（无文件时从 example 创建）
  setup [uboot|kernel|ethercat|all] [--update]
                         克隆/刷新源码；KERNEL_RT=y 时打 PREEMPT_RT 补丁
  sync dts|config        同步设备树覆盖或 kernel config
  uboot [--clean|--update]
                         编译 U-Boot + OpenSBI（已有产物则跳过）
  kernel [--clean|--update]
                         编译内核 Image + dtb（默认 PREEMPT_RT + slim）
  ethercat [--clean|--update]
                         外置 IgH EtherCAT（generic ko + CLI；需先编内核）
  bootimg [--clean|--update]
                         打包 FAT boot.img + boot.scr（已有则跳过）
  rootfs [--clean|--update]
                         构建 Debian riscv64 rootfs（含 rt-tests）
  modules [ROOTFS]       安装内核模块到 rootfs（默认 out/rootfs）
  pack [--stage-only] [--clean|--update]
                         打包可 dd 的 SD 镜像 out/${BOARD}.img
  emmc /dev/mmcblkN [--yes] [--uboot-only]
                         安装到板载 eMMC（写 boot0 + 分区 + 系统）
  all [选项]             全流程（各步有缓存则跳过）
  clean [目标]           清除缓存：uboot|kernel|ethercat|bootimg|rootfs|pack|dl|out|sources|toolchain|all
  help                   显示本帮助

all / 编译选项:
  --skip-rootfs          跳过 rootfs
  --skip-pack            跳过 SD 镜像
  --clean, --force       忽略全部构建缓存，强制重编
                         （uboot / kernel / ethercat / bootimg / rootfs / pack）
  --update               刷新全部下载并重建衍生产物：
                         toolchain、u-boot/kernel/IgH 源码、RT 补丁、rootfs

全局选项（写在 command 前或后均可）:
  -j N                   并行编译任务数（MAKE_JOBS）
  --board NAME           UBOOT_BOARD（如 x1）
  --cross-compile PREFIX CROSS_COMPILE_PREFIX（如 riscv64-unknown-linux-gnu-）

示例:
  ./bsp env                    # 依赖 + Ky toolchain
  ./bsp all                    # 增量：有缓存跳过
  ./bsp all --clean            # 强制重编全部构建缓存
  ./bsp all --update           # 刷新下载 + 重建
  ./bsp env --update           # 重新下载 toolchain
  ./bsp clean all              # 清 out/构建产物/dl（保留 sources、toolchain）
  ./bsp emmc /dev/mmcblk1 --yes   # SD 启动后装入 eMMC
  ./bsp emmc /dev/mmcblk1 --yes --uboot-only
  ./bsp uboot --clean
EOF
}

cmd_config() {
	if [[ ! -f "${CONFIG_FILE}" ]]; then
		[[ -f "${CONFIG_EXAMPLE}" ]] || die "缺少 ${CONFIG_EXAMPLE}"
		cp "${CONFIG_EXAMPLE}" "${CONFIG_FILE}"
		info "已创建 ${CONFIG_FILE}（自 config.env.example）"
	fi

	if [[ $# -eq 0 ]]; then
		grep -vE '^\s*(#|$)' "${CONFIG_FILE}" || true
		return
	fi

	local spec="$1"
	if [[ "${spec}" == *"="* ]]; then
		local key="${spec%%=*}"
		local val="${spec#*=}"
		[[ -n "${key}" ]] || die "无效: ${spec}"
		if grep -qE "^[# ]*${key}=" "${CONFIG_FILE}"; then
			sed -i -E "s|^[# ]*${key}=.*|${key}=${val}|" "${CONFIG_FILE}"
		else
			printf '\n%s=%s\n' "${key}" "${val}" >> "${CONFIG_FILE}"
		fi
		info "已设置 ${key}=${val}"
	else
		grep -E "^[# ]*${spec}=" "${CONFIG_FILE}" || die "未找到配置项: ${spec}"
	fi
}

# 预解析：分离全局选项与子命令参数
ARGS=()
COMMAND=""
while [[ $# -gt 0 ]]; do
	case "$1" in
		-h|--help|help)
			usage
			exit 0
			;;
		-j)
			[[ $# -ge 2 ]] || { echo "需要 -j N" >&2; exit 1; }
			export MAKE_JOBS="$2"
			shift 2
			;;
		-j*)
			export MAKE_JOBS="${1#-j}"
			shift
			;;
		--board)
			[[ $# -ge 2 ]] || { echo "需要 --board NAME" >&2; exit 1; }
			export UBOOT_BOARD="$2"
			shift 2
			;;
		--board=*)
			export UBOOT_BOARD="${1#--board=}"
			shift
			;;
		--cross-compile)
			[[ $# -ge 2 ]] || { echo "需要 --cross-compile PREFIX" >&2; exit 1; }
			export CROSS_COMPILE_PREFIX="$2"
			shift 2
			;;
		--cross-compile=*)
			export CROSS_COMPILE_PREFIX="${1#--cross-compile=}"
			shift
			;;
		--clean|--force)
			export BSP_FORCE=1
			ARGS+=("$1")
			shift
			;;
		--update)
			export BSP_UPDATE=1
			ARGS+=("$1")
			shift
			;;
		-*)
			# 子命令选项（如 --skip-rootfs），可出现在命令前后
			ARGS+=("$1")
			shift
			;;
		*)
			if [[ -z "${COMMAND}" ]]; then
				COMMAND="$1"
			else
				ARGS+=("$1")
			fi
			shift
			;;
	esac
done

if [[ -z "${COMMAND}" ]]; then
	usage
	exit 1
fi

# help / config 允许尚无 config.env
case "${COMMAND}" in
	help)
		usage
		exit 0
		;;
	config)
		# shellcheck source=scripts/lib.sh
		BSP_ALLOW_MISSING_CONFIG=1
		# shellcheck source=/dev/null
		source "${SCRIPT_DIR}/lib.sh"
		cmd_config "${ARGS[@]+"${ARGS[@]}"}"
		exit 0
		;;
esac

# shellcheck source=/dev/null
source "${SCRIPT_DIR}/lib.sh"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/mod-env.sh"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/mod-sources.sh"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/mod-uboot.sh"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/mod-kernel.sh"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/mod-ethercat.sh"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/mod-rootfs.sh"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/mod-pack.sh"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/mod-clean.sh"

case "${COMMAND}" in
	env) cmd_env "${ARGS[@]+"${ARGS[@]}"}" ;;
	setup) cmd_setup "${ARGS[@]+"${ARGS[@]}"}" ;;
	sync) cmd_sync "${ARGS[@]+"${ARGS[@]}"}" ;;
	uboot|u-boot) cmd_uboot "${ARGS[@]+"${ARGS[@]}"}" ;;
	kernel) cmd_kernel "${ARGS[@]+"${ARGS[@]}"}" ;;
	ethercat) cmd_ethercat "${ARGS[@]+"${ARGS[@]}"}" ;;
	bootimg) cmd_bootimg "${ARGS[@]+"${ARGS[@]}"}" ;;
	rootfs) cmd_rootfs "${ARGS[@]+"${ARGS[@]}"}" ;;
	modules) cmd_modules "${ARGS[@]+"${ARGS[@]}"}" ;;
	pack) cmd_pack "${ARGS[@]+"${ARGS[@]}"}" ;;
	emmc) cmd_emmc "${ARGS[@]+"${ARGS[@]}"}" ;;
	all) cmd_all "${ARGS[@]+"${ARGS[@]}"}" ;;
	clean) cmd_clean "${ARGS[@]+"${ARGS[@]}"}" ;;
	tools)
		case "${ARGS[0]:-host}" in
			host) cmd_env_host_tools ;;
			*) die "tools 用法: ./bsp tools host" ;;
		esac
		;;
	*)
		die "未知命令: ${COMMAND}（./bsp help）"
		;;
esac
