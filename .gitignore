# 本地配置
config.env
.local/

# 克隆的源码与编译产物
sources/
backup/
out/

# Rockchip 打包工具（由 ./bsp pack / tools pack 安装）
vendor/tools/pack-firmware/afptool
vendor/tools/pack-firmware/rkImageMaker

# 构建日志
logs/
*.log

# 二进制镜像
*.bin
# A7Z 引导链的官方闭源成品（boot0/boot0_ufs/scp），必须入库
!vendor/a733/*.bin
*.img
*.itb
*.dtb
# 允许入库的 AP6212A WiFi/BT 固件（取自 SDK external/rkwifibt）
!vendor/firmware/ap6212/*.bin
!vendor/firmware/ap6212/*.hcd

# 编辑器
.vscode/
.idea/
*~
