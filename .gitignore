# 本地配置
config.env
.local/

# 克隆的源码与编译产物
sources/
backup/
out/

# Rockchip 打包工具（由 ./bsp pack / tools pack 安装）
vendor/tools/pack-firmware/afptool
vendor/tools/pack-firmware/rkImageMaker

