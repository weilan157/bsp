# 复制为 config.env 后修改
# cp config.env.example config.env

# 泰山派 SDK 根目录（用于备份 rkbin、链接 prebuilts）
TSPI_SDK_ROOT="/data/3576/4.【立创·泰山派3】系统SDK包/Buildroot_Debian12_Ubuntu24/2026-04-01（New）/TaishanPi-3-Linux"

# GitHub 仓库与分支
UBOOT_REPO="https://github.com/rockchip-linux/u-boot.git"
UBOOT_BRANCH="next-dev"
RKBIN_REPO="https://github.com/rockchip-linux/rkbin.git"
RKBIN_BRANCH="master"

# RK3576 U-Boot defconfig 名（传给 ./make.sh）
UBOOT_BOARD="rk3576"

# 是否使用 SDK 预置交叉工具链（推荐）
USE_SDK_PREBUILTS="y"

# 交叉编译前缀（USE_SDK_PREBUILTS=n 时使用系统 apt 链）
CROSS_COMPILE_PREFIX="aarch64-linux-gnu-"

# 并行编译线程数（空则自动 nproc）
MAKE_JOBS=""

# TaishanPi SDK lunch defconfig（Recovery OTA 构建）
TSPI_DEFCONFIG="tspi_3m_rk3576_debian_bookworm_desktop_defconfig"
