# 复制为 config.env 后修改，或运行: ./bsp config
# 查看全部命令: ./bsp help
# cp config.env.example config.env
#
# 本分支：microduck —— 泰山派 1M（RK3566）极致精简 BSP
#      + Cubie A7Z（Allwinner A733）精简 BSP：把 PLATFORM 改成 a733

# ---------- 平台 ----------
# rk3566：Rockchip 泰山派（默认流程）
# a733  ：Radxa Cubie A7Z（Allwinner A733），走 Radxa 的 debian 打包流程
PLATFORM=rk3566

# ---------- A733（PLATFORM=a733 时生效） ----------
# 内核版本：5.15（Radxa 打包仓库，出 deb）| 6.6（全志官方 v1.4.8 三件套，原生 Image+dtb）
A733_KERNEL_VERSION=5.15

# 5.15：Radxa 的 Debian 打包仓库（含 submodule：kernel 5.15 BSP / u-boot + boot0）
# A733_KERNEL_REPO="https://github.com/radxa-pkg/linux-a733.git"
# A733_UBOOT_REPO="https://github.com/radxa-pkg/u-boot-aw2501.git"
# A733_RSDK_REPO="https://github.com/RadxaOS-SDK/rsdk.git"
# A733_BOARD="radxa-a733"
# A733_WITH_RSDK=n          # y 时 ./bsp setup 也克隆 rsdk（出 output.img 用）
# A733_KERNEL_DEFCONFIG="defconfig radxa.config microduck.config"

# 6.6：全志 v1.4.8 的 kernel / bsp / device（board.dts 在 device 里）
# A733_KERNEL_SRC_BRANCH="allwinner-aiot-linux-6.6"
# A733_BSP_BRANCH="cubie-aiot-v1.4.8"
# A733_DEVICE_BRANCH="device-a733-v1.4.8"
# A733_DTS_NAME="sun60i-a733-cubie-a7z"

# GitHub 仓库与分支
UBOOT_REPO="https://github.com/rockchip-linux/u-boot.git"
UBOOT_BRANCH="next-dev"
RKBIN_REPO="https://github.com/rockchip-linux/rkbin.git"
RKBIN_BRANCH="master"

# U-Boot defconfig 名（传给 ./make.sh），RK3566 的 board 名就是 rk3566
UBOOT_BOARD="rk3566"
# make.sh 产物：RK3566 只有 loader（MiniLoaderAll），没有 idblock。
# 名字由 rkbin 的 RKBOOT/RK3566MINIALL.ini 决定：新版 rkbin 产出
# rk356x_loader_vX.YY.ZZZ.bin，旧版是 rk356x_spl_loader_...，用通配匹配两者
UBOOT_LOADER_PATTERN="*_loader_*.bin"
UBOOT_IDBLOCK_PATTERN=""

# 内核：GitHub 镜像 rockchip-linux/kernel（对应 SDK 的 rk/kernel-stable 6.1）
#   develop-6.1 目前是 6.1.172；泰山派 SDK 是 linux-6.1-stan-rkr7（6.1.141）。
#   想严格用 SDK 的内核时，把 KERNEL_REPO 指向本机 SDK 的 kernel 仓库即可：
#     KERNEL_REPO="/path/to/sdk/.repo/projects/kernel-6.1.git"
#     KERNEL_BRANCH="tspi-1m-local"
KERNEL_REPO="https://github.com/rockchip-linux/kernel.git"
KERNEL_BRANCH="develop-6.1"
KERNEL_DEFCONFIG="rockchip_linux_defconfig"
KERNEL_DEFCONFIG_FRAGMENTS="rk3566.config bsp-boot.config tspi-1m.config microduck-tiny.config"
# 设备树文件名（不含 .dts/.dtb），取自 SDK 的 RK_KERNEL_DTS_NAME
KERNEL_DTS_NAME="tspi-rk3566-micro"
# 同步板级文件用的通配（SDK 的 dts + 6 个 dtsi 都以 tspi-rk3566- 开头）
DTS_FILES_GLOB="tspi-rk3566-*"

# 泰山派设备树来源（留空则用仓库 vendor/dts/rockchip）
# 从本机 SDK 刷新时指向其 kernel dts 目录，例如
#   TSPI_DTS_SOURCE="/path/to/sdk/kernel/arch/arm64/boot/dts/rockchip"
# TSPI_DTS_SOURCE=""

# 随板级 dts 一起同步的额外文件（逗号或空格分隔，仅 ./bsp sync dts 用）
# DTS_EXTRA_FILES=""

# 可选：叠加泰山派 SDK 风格内核配置（PANFROST、Mali Bifrost、GT9xx 等）
# y = 使用 vendor/kernel-config/tspi-vendor.config
TSPI_VENDOR_KERNEL_CONFIG=n

# 可选：从 SDK configs 目录刷新 fragment 后再安装（./bsp sync config）
# TSPI_KERNEL_CONFIG_SOURCE="/path/to/TaishanPi-Linux/kernel/arch/arm64/configs"

# 可选：额外 defconfig fragment 名（逗号或空格分隔，须已在 kernel configs 或 vendor/kernel-config）
# KERNEL_EXTRA_FRAGMENTS=""

# 交叉编译前缀（需 apt 安装 gcc-aarch64-linux-gnu，见 ./bsp env）
CROSS_COMPILE_PREFIX="aarch64-linux-gnu-"

# 可选：自定义工具链 bin 目录（留空则用 PATH 中的 CROSS_COMPILE_PREFIX）
# 例：TOOLCHAIN_BIN="/opt/gcc-aarch64/bin"
TOOLCHAIN_BIN=""

# 可选：clone 前备份本地已有 rkbin 到 backup/（任意路径，与 SDK 无关）
# RKBIN_BACKUP_SRC=""

# 并行编译线程数（空则自动 nproc；也可用 ./bsp -j 8 ...）
MAKE_JOBS=""

# ---------- rootfs ----------
# debian = 官方 debootstrap 无桌面（默认）
# micro  = microduck 精简版：sysvinit + busybox、无 systemd/udev、ZRAM、开机扩容
ROOTFS_TYPE=micro

# 发行版：trixie=Debian 13；若主机 debootstrap 不支持可改为 bookworm
DEBIAN_RELEASE=trixie
DEBIAN_ARCH=arm64
DEBIAN_MIRROR=mirrors.tuna.tsinghua.edu.cn
DEBIAN_VARIANT=minbase

ROOTFS_HOSTNAME=microduck
ROOTFS_LOCALE=en_US.UTF-8
ROOTFS_ROOT_PASSWORD=root
ROOTFS_USER=debian
ROOTFS_USER_PASSWORD=debian

# FIT boot.img（vendor/fit/boot.its）
# BOOT_FIT_ITS=""
# MKIMAGE_BIN=""   # 默认 u-boot/tools/mkimage 或 rkbin/tools/mkimage

# 构建 Debian rootfs 时安装内核模块（须先 ./bsp kernel）
KERNEL_MODULES_INSTALL=y

# update.img 打包（afptool / rkImageMaker，./bsp pack 自动下载）
# PACK_TOOLS_DIR=""      # 默认 vendor/tools/pack-firmware
# PACK_TOOLS_SRC=""      # 可选：泰山派 SDK .../Linux_Pack_Firmware/rockdev
# 无 SDK 时自动多镜像下载（Linux amd64）；可覆盖首选或完整列表
# PACK_TOOLS_DOWNLOAD_BASE="https://cdn.jsdelivr.net/gh/vicharak-in/rockchip-linux-tools@master/linux/Linux_Pack_Firmware/rockdev"
# PACK_TOOLS_DOWNLOAD_MIRRORS="url1 url2"
# 国内 jsdelivr 打不开时可换成 ghfast 代理的 raw 地址：
# PACK_TOOLS_DOWNLOAD_MIRRORS="https://ghfast.top/https://raw.githubusercontent.com/vicharak-in/rockchip-linux-tools/master/linux/Linux_Pack_Firmware/rockdev"
# update.img 头里的芯片标识；留空则自动推导（rk356x 通用 loader 头里是 3568，
# 会自动按 UBOOT_BOARD 改成 RK3566），需要时可强制指定
# PACK_CHIP_TAG="RK3566"
# FIRMWARE_PARAMETER=""  # 默认 vendor/firmware/parameter.txt
# FIRMWARE_PACKAGE_FILE=""  # 默认 vendor/firmware/package-file
