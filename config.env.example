# 复制为 config.env 后修改，或运行: ./bsp config
# 查看全部命令: ./bsp help
# cp config.env.example config.env

# ---------- 板型：Orange Pi R2S（Ky X1） ----------
BOARD=orangepir2s

# GitHub 仓库与分支（Orange Pi Ky X1）
UBOOT_REPO="https://github.com/orangepi-xunlong/u-boot-orangepi.git"
UBOOT_BRANCH="v2022.10-ky"
# Ky 不使用 rockchip rkbin
RKBIN_REPO=""
RKBIN_BRANCH=""

# U-Boot defconfig（传给 make）
UBOOT_BOARD="x1"

# 内核
KERNEL_REPO="https://github.com/orangepi-xunlong/linux-orangepi.git"
KERNEL_BRANCH="orange-pi-6.6-ky"
KERNEL_ARCH=riscv
# 空：使用 vendor/kernel-config/linux-ky-current.config（orangepi-build）
# 或设为 x1_defconfig 使用内核树内 defconfig
KERNEL_DEFCONFIG=""
KERNEL_DOTCONFIG=""
KERNEL_DEFCONFIG_FRAGMENTS=""
# PREEMPT_RT（默认 y）：下载并打 6.6.63-rt46 + Ky 适配，并合并 rt.config
KERNEL_RT=y
# KERNEL_RT_PATCH_URL="https://cdn.kernel.org/pub/linux/kernel/projects/rt/6.6/older/patch-6.6.63-rt46.patch.xz"
# 默认 fragment=slim + rt；恢复非 RT 全量可设 KERNEL_RT=n 且 KERNEL_EXTRA_FRAGMENTS=
# KERNEL_EXTRA_FRAGMENTS=""
# Orange Pi R2S 设备树
KERNEL_DTS_NAME="x1_orangepi-r2s"
KERNEL_DTS_SUBDIR="ky"

# 可选：覆盖设备树来源（留空则用内核树自带 ky dts）
# VENDOR_DTS_SOURCE=""

# 交叉编译前缀（Ky 官方工具链，./bsp env 会下载）
CROSS_COMPILE_PREFIX="riscv64-unknown-linux-gnu-"

# 可选：自定义工具链 bin 目录（留空则用 ./bsp env 安装的 Ky toolchain）
# 例：TOOLCHAIN_BIN="/opt/ky-toolchain/.../bin"
TOOLCHAIN_BIN=""

# Ky toolchain 下载（orangepi-build 同源）
TOOLCHAIN_NAME="ky-toolchain-linux-glibc-x86_64-v1.0.1"
TOOLCHAIN_URL="http://www.iplaystore.cn/upload/_toolchain/ky-toolchain-linux-glibc-x86_64-v1.0.1.tar.xz"

# 并行编译线程数（空则自动 nproc；也可用 ./bsp -j 8 ...）
MAKE_JOBS=""

# ---------- Debian 官方无桌面 rootfs（debootstrap） ----------
# 发行版：trixie=Debian 13；若主机 debootstrap 不支持可改为 bookworm
DEBIAN_RELEASE=trixie
DEBIAN_ARCH=riscv64
DEBIAN_MIRROR=mirrors.tuna.tsinghua.edu.cn
DEBIAN_VARIANT=minbase

ROOTFS_HOSTNAME=orangepi
ROOTFS_LOCALE=en_US.UTF-8
ROOTFS_ROOT_PASSWORD=root
ROOTFS_USER=weiqi
ROOTFS_USER_PASSWORD=321

# 构建 Debian rootfs 时安装内核模块（须先 ./bsp kernel）
KERNEL_MODULES_INSTALL=y

# ---------- SD 镜像打包（非 Rockchip update.img） ----------
# 首分区起始偏移（MiB），与 orangepi-build ky.conf OFFSET 一致
SD_OFFSET_MIB=30
# boot 分区大小（MiB，FAT）
SD_BOOT_MIB=256
# rootfs 额外余量（MiB）
SD_ROOTFS_EXTRA_MIB=256
# 输出镜像名（默认 out/${BOARD}.img）
# SD_IMAGE=""
